# =============================================================================
# Production environment template / Шаблон переменных окружения для продакшна
# =============================================================================
# Copy this file to .env.production and fill in REAL values before deploying.
# Скопируйте этот файл в .env.production и заполните РЕАЛЬНЫМИ значениями.
#
# NEVER commit the real .env.production. / НИКОГДА не коммитьте реальный .env.
# Generate long random secrets with: openssl rand -hex 64
# =============================================================================

NODE_ENV=production
PRODUCTION=1
SERVER_PORT=3000

# Public base URL the server is reachable at.
# Публичный URL, на котором доступен сервер.
ROOT_URL=https://api.bjj-academy.example.com

# -----------------------------------------------------------------------------
# Database / База данных
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@db.internal:5432/bjj_academy?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ queues + rate limiting) / Очереди и rate-limit
# -----------------------------------------------------------------------------
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT — access/refresh tokens / JWT для access/refresh токенов
# -----------------------------------------------------------------------------
JWT_ISSUER_URL=https://api.bjj-academy.example.com
JWT_AUDIENCE_URL=https://api.bjj-academy.example.com
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
# REQUIRED in prod, must be >= 32 chars. / Обязателен, минимум 32 символа.
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_FROM_OPENSSL_RAND

# -----------------------------------------------------------------------------
# Playback token / Токен для HLS-плеера
# Must be DIFFERENT from JWT_SECRET. / Должен ОТЛИЧАТЬСЯ от JWT_SECRET.
# REQUIRED in prod, must be >= 32 chars.
# Generate: openssl rand -hex 64
# -----------------------------------------------------------------------------
PLAYBACK_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX

# -----------------------------------------------------------------------------
# Encryption key for at-rest secrets (TFA seeds etc.) / Шифрование TFA-секретов
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
ENCRYPTION_SECRET=REPLACE_WITH_32_BYTE_HEX

# -----------------------------------------------------------------------------
# Super admin bootstrap / Начальный супер-админ
# REQUIRED in production; без него bootstrap упадёт.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@bjj-academy.example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# SMTP transport / Транспорт для писем (OTP-коды, нотификации)
# -----------------------------------------------------------------------------
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
SMTP_NO_REPLY_EMAIL=noreply@bjj-academy.example.com
# Resend cooldown for OTP codes, in milliseconds. 60000 = 1 min.
COMPLETE_CODE_TIMEOUT=60000

# -----------------------------------------------------------------------------
# S3-compatible storage (AWS S3 / Cloudflare R2 / MinIO)
# Хранилище видео и HLS-сегментов
# -----------------------------------------------------------------------------
S3_UPLOAD_BUCKET_URL=https://s3.us-west-1.amazonaws.com
S3_REGION=us-west-1
S3_BUCKET_NAME=bjj-academy-prod
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET
# false for real AWS S3, true for MinIO / R2 path-style.
S3_FORCE_PATH_STYLE=false
S3_ACCELERATE_URL=
S3_ACL=private

# -----------------------------------------------------------------------------
# CORS — comma-separated, NO wildcards in prod / без "*" в продакшне
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://admin.bjj-academy.example.com,https://app.bjj-academy.example.com

# -----------------------------------------------------------------------------
# Default workspace bootstrap / Дефолтный workspace при первом запуске
# -----------------------------------------------------------------------------
DEFAULT_WORKSPACE_KEY=bjj-academy
DEFAULT_WORKSPACE_NAME=BJJ Academy
DEFAULT_WORKSPACE_TYPE=GRAPPLING

# -----------------------------------------------------------------------------
# Sentry — error monitoring / Мониторинг ошибок
# Leave empty to disable. / Пустое значение отключает Sentry.
# -----------------------------------------------------------------------------
SENTRY_DSN=https://PUBLIC_KEY@oXXXXXX.ingest.sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend Sentry (admin + client Next.js). Public DSN is OK to expose.
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@oXXXXXX.ingest.sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Frontend public env / Публичные переменные для Next.js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.bjj-academy.example.com
NEXT_PUBLIC_MINIO_BUCKET=bjj-academy-prod
NEXT_PUBLIC_BRAND=grappling

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications) — PLACEHOLDER, not wired yet.
# Firebase для пуш-уведомлений — пока заглушка, интеграция в работе.
# -----------------------------------------------------------------------------
FIREBASE_SERVER_KEY=REPLACE_WHEN_FCM_IS_WIRED_UP
