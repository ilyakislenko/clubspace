# =============================================================================
# Production environment template / Шаблон переменных окружения для продакшна
# =============================================================================
# Copy this file to .env.production and fill in REAL values before deploying.
# Скопируйте этот файл в .env.production и заполните РЕАЛЬНЫМИ значениями.
#
# Or let deploy/init.sh write the whole thing for you — it generates every
# secret below and checks DNS before starting anything.
# Либо просто запустите deploy/init.sh — он сгенерирует все секреты сам.
#
# NEVER commit the real .env.production. / НИКОГДА не коммитьте реальный .env.
# Generate long random secrets with: openssl rand -hex 64
# =============================================================================

# -----------------------------------------------------------------------------
# Domain / Домен — единственное место, где он задаётся
# Everything else (api./admin./app./s3. hostnames, CORS, the API URL baked into
# the web bundles) is derived from this in docker-compose.prod.yml.
# All four subdomains must resolve to this host BEFORE first start, or Caddy's
# ACME HTTP-01 challenge fails and no certificate is issued.
# -----------------------------------------------------------------------------
DOMAIN=clubspace.example.com
ACME_EMAIL=admin@clubspace.example.com

# Non-standard HTTPS port, when 443 is unavailable — many residential ISPs drop
# inbound 80 and 443 while leaving every other port alone. Leave EMPTY for a
# normal install; set to ":8443" (with the colon) to serve there instead.
# It appears in every public URL: tokens are validated against the issuer and
# uploads are signed for the storage origin, so a half-applied port fails at
# runtime rather than at startup. Port 80 being blocked also rules out ACME
# HTTP-01 — issue certificates over the DNS challenge instead.
PUBLIC_PORT_SUFFIX=

# Host ports the bundled Caddy publishes. Defaults are the standard ones.
# Set them to e.g. 8080 and 8443 when another reverse proxy already owns 80/443
# and you want ONLY this stack reachable from the internet: forward external
# 80 -> 8080 and 443 -> 8443 on the router, and the other proxy — still bound to
# 80/443 — never receives outside traffic at all. Public URLs stay clean.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

NODE_ENV=production
PRODUCTION=1
SERVER_PORT=3000

# DATABASE_URL, REDIS_HOST, REDIS_PORT, S3_UPLOAD_BUCKET_URL,
# S3_FORCE_PATH_STYLE, ROOT_URL, ADMIN_URL, APP_URL, JWT_ISSUER_URL,
# JWT_AUDIENCE_URL, CORS_ORIGINS and NEXT_PUBLIC_API_URL are all derived from
# DOMAIN and the compose service names in docker-compose.prod.yml. Setting them
# here has no effect. / Эти переменные выводятся автоматически — задавать их тут бесполезно.

# -----------------------------------------------------------------------------
# Database / База данных
# Postgres runs inside the stack and is not exposed to the host.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=clubspace
# REQUIRED — compose refuses to start without it. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Postgres connections per server process (default 10). Keep
# replicas × DATABASE_POOL_MAX + workers under Postgres max_connections (100).
# DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis (BullMQ queues + rate limiting) / Очереди и rate-limit
# REQUIRED — compose refuses to start without it. Generate: openssl rand -hex 24
# -----------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_DB=0
# Notifications older than this are deleted by the nightly purge.
# Уведомления старше N дней удаляются ночной очисткой.
NOTIFICATION_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# JWT — access/refresh tokens / JWT для access/refresh токенов
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
# REQUIRED in prod, must be >= 32 chars. / Обязателен, минимум 32 символа.
# Generate: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_FROM_OPENSSL_RAND

# -----------------------------------------------------------------------------
# Playback token / Токен для HLS-плеера
# Must be DIFFERENT from JWT_SECRET — the server refuses to start if they match,
# since one leaked secret would then forge both sessions and video URLs.
# Должен ОТЛИЧАТЬСЯ от JWT_SECRET: сервер не стартует, если они совпадают.
# Generate: openssl rand -hex 64
# -----------------------------------------------------------------------------
PLAYBACK_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX

# -----------------------------------------------------------------------------
# Encryption key for at-rest secrets (TFA seeds etc.) / Шифрование TFA-секретов
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
ENCRYPTION_SECRET=REPLACE_WITH_32_BYTE_HEX

# The server refuses to start while any of the three secrets above still holds
# a REPLACE_WITH… placeholder or a dev- value. / Сервер не стартует, пока в
# секретах выше остаются заглушки REPLACE_WITH… или значения dev-….

# -----------------------------------------------------------------------------
# API reference (Scalar at https://api.<domain>/api). Off in production unless
# set to true — it lists every route. / Документация API выключена в проде,
# пока не включена явно.
# -----------------------------------------------------------------------------
API_DOCS_ENABLED=false

# -----------------------------------------------------------------------------
# Platform owner / Владелец платформы
# On every boot the account with this address is created (or promoted) as a
# platform admin. Sign-in is by emailed OTP, so there is no password to set —
# whoever controls this mailbox controls the platform. Use a real, secured
# inbox. / Аккаунт с этим адресом создаётся/повышается до админа платформы при
# каждом старте. Вход — по коду на почту, пароля нет: доступ к ящику = доступ
# к платформе.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Store review account / Аккаунт для проверки магазинов (необязательно)
# Google Play / App Store reviewers can't read our mail, so this one email signs
# in with a fixed 6-digit code (put both in the Play Console access notes). Set
# BOTH or neither; the code must not be guessable (no 123456, 111111) and the
# email must differ from SUPER_ADMIN_EMAIL. Keep it set: every app update is
# reviewed again. / Ревьюеры магазинов не читают нашу почту: этот адрес входит
# по фиксированному 6-значному коду. Задавайте оба значения или ни одного; не
# убирайте — каждое обновление приложения проверяют заново.
# -----------------------------------------------------------------------------
# STORE_REVIEW_EMAIL=review@example.com
# Generate: LC_ALL=C tr -dc 0-9 </dev/urandom | head -c6
# STORE_REVIEW_CODE=REPLACE_WITH_6_RANDOM_DIGITS
# Key of a demo club with real content. On every review sign-in the reviewer is
# made an ACTIVE student of it (audited), so the review never sees an empty app.
# Needs the two above. / Ключ демо-клуба с контентом: при каждом входе ревьюер
# становится его активным учеником (пишется в журнал).
# STORE_REVIEW_WORKSPACE_KEY=demo_club

# -----------------------------------------------------------------------------
# App store links / Ссылки на приложение (необязательно)
# Shown as buttons in e-mails to new members and on the app.<domain>/join page;
# each button is hidden while its URL is unset. / Кнопки в письмах и на
# странице приглашения; пока приложения нет в магазине — не задавайте.
# -----------------------------------------------------------------------------
# APP_STORE_URL=https://apps.apple.com/app/id0000000000
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.clubspace.app
# RUSTORE_URL=https://www.rustore.ru/catalog/app/com.clubspace.app
# Installable web app; «Открыть в браузере» on /join opens ${PWA_URL}/join/<code>.
# PWA_URL=https://pwa.example.com

# -----------------------------------------------------------------------------
# App links / Universal Links для /join/* (необязательно)
# Served by app.<domain>/.well-known/*; the file is 404 while unset.
# Lists are comma-separated. / Списки — через запятую.
# -----------------------------------------------------------------------------
# APPLE_TEAM_ID=ABCDE12345
# IOS_BUNDLE_ID=com.clubspace.app
# ANDROID_PACKAGE=com.clubspace.app
# ANDROID_CERT_SHA256=AA:BB:CC:...

# -----------------------------------------------------------------------------
# SMTP transport / Транспорт для писем (OTP-коды, нотификации)
# Not optional: sign-in is a code sent by email, so a broken transport locks
# out every account including the platform owner. /readyz checks it.
# Sending straight from a residential IP lands in spam — use a relay and add
# SPF, DKIM and DMARC records for the domain.
# -----------------------------------------------------------------------------
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
SMTP_NO_REPLY_EMAIL=noreply@clubspace.example.com
# Resend cooldown for OTP codes, in milliseconds. 60000 = 1 min.
COMPLETE_CODE_TIMEOUT=60000

# Contact details printed on the public /legal/* pages (baked into the client
# image at build time — rebuild `client` after changing). All optional.
SUPPORT_EMAIL=
LEGAL_OPERATOR=
LEGAL_ADDRESS=

# Edition of the personal-data consent (152-ФЗ). One value drives both the
# server gate and the client's /legal/consent page. Bumping it makes every user
# re-accept the consent in the apps on next request.
CONSENT_VERSION=2026-11-01

# -----------------------------------------------------------------------------
# Object storage / Хранилище видео — MinIO из docker-compose.prod.yml
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are MinIO's ROOT credentials. Only the
# bootstrap (minio-init) and the media backup use them. The server and the
# worker sign in with their own service accounts, which minio-init creates
# with the least each one needs (server: objects in the bucket; worker: read
# raw/, write hls/) — a leaked app env no longer means a leaked storage admin.
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY — root MinIO, только для minio-init и
# бэкапа. Сервер и воркер ходят под своими ограниченными учётками ниже.
# Generate: openssl rand -hex 16 / openssl rand -hex 32
# -----------------------------------------------------------------------------
S3_ACCESS_KEY_ID=REPLACE_WITH_RANDOM_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
# Service accounts. The key ids can stay as they are; the secrets are REQUIRED
# (compose refuses to start without them). Generate: openssl rand -hex 32
# After changing one, apply it with: docker compose ... up minio-init
S3_SERVER_ACCESS_KEY_ID=clubspace-server
S3_SERVER_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
S3_WORKER_ACCESS_KEY_ID=clubspace-worker
S3_WORKER_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
S3_BUCKET_NAME=clubspace
# Keep private. Playback goes through the membership-checked manifest proxy,
# which signs short-lived segment URLs; only thumbnails/ and subtitles/ are
# anonymously readable, and minio-init sets exactly that policy.
S3_ACL=private
# Required by the server and worker; MinIO accepts any value.
S3_REGION=us-east-1
# Largest single video upload, in MiB. At most 5120: the browser uploads in one
# PUT, which S3 caps at 5 GiB — the server and worker refuse to start above it.
# Максимальный размер одного видео, МиБ. Не больше 5120 (лимит одного PUT в S3).
MAX_VIDEO_UPLOAD_MB=5120

# -----------------------------------------------------------------------------
# Video worker / Обработка видео
# TRANSCODE_CONCURRENCY: parallel transcodes. Each is a full ffmpeg encode of
# two renditions — raise only with spare cores and RAM.
# MAX_VIDEO_DURATION_MINUTES: longer uploads are refused before encoding.
# VIDEO_TRANSCODE_TIMEOUT_MS: hard ceiling on one encode, in milliseconds.
# -----------------------------------------------------------------------------
TRANSCODE_CONCURRENCY=1
MAX_VIDEO_DURATION_MINUTES=240
VIDEO_TRANSCODE_TIMEOUT_MS=1800000

# -----------------------------------------------------------------------------
# Backups / Бэкапы (db-backup + media-backup services)
# BACKUP_DIR is a HOST path. Put it on a second disk or a NAS mount: a backup on
# the same disk as the data does not survive that disk dying.
# BACKUP_DIR — путь на хосте; держите его на другом диске или NAS.
# BACKUP_HEALTHCHECK_URL (optional): healthchecks.io-style ping after every
# round, <url>/fail on failure — so a backup that stops gets noticed.
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/clubspace
BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MIN=7
BACKUP_INTERVAL_HOURS=24
BACKUP_HEALTHCHECK_URL=

# -----------------------------------------------------------------------------
# No club seeding in production / Никакого сидирования клубов в проде
# A production install starts with the platform owner above and NOTHING else:
# no workspace, no sample categories, tags, plans or courses. Clubs are created
# in the platform console (/platform in the admin) — name + owner email — and
# handed to their owner. / Прод стартует только с владельцем платформы:
# ни воркспейсов, ни демо-данных. Клубы создаются в консоли /platform.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Sentry — error monitoring / Мониторинг ошибок
# Leave empty to disable. / Пустое значение отключает Sentry.
# The server and the video worker read SENTRY_DSN / SENTRY_ENVIRONMENT. The
# admin and client images accept exactly one build arg — NEXT_PUBLIC_API_URL,
# derived from DOMAIN — so NEXT_PUBLIC_* variables set here would never reach
# their bundles.
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Push notifications / Пуш-уведомления
# The server sends through Expo's push service, which needs FCM credentials
# uploaded to your EAS project — not an env var here. Until that is done the
# app registers no token and notifications silently never arrive. Nothing in
# this file changes that. / Пуши настраиваются в EAS (FCM-ключ), не здесь.
# -----------------------------------------------------------------------------

# Platform billing of clubs: monthly price by ACTIVE members (Старт ≤50 2 990,
# Клуб ≤100 5 990, Про ≤200 9 990, Бизнес ≤400 16 990, Сеть 16 990 + 35 ₽ за
# каждого сверх 400), paid modules VIDEO / ONLINE_PAYMENTS / BRANDED_APP, annual
# prepay discount and a one-time setup fee. Whole rubles. Payment collection is
# manual: the platform console (/platform) marks a period paid.
# false = self-hosted install: every module on, no trial expiry, no banners.
PLATFORM_BILLING_ENABLED=true
# Public «Создать клуб» wizard at <admin>/sign-up (30-day trial, one per account).
SELF_SERVE_SIGNUP_ENABLED=false
# PLATFORM_TRIAL_DAYS=30
# PLATFORM_GRACE_DAYS=7
# PLATFORM_ANNUAL_DISCOUNT_PERCENT=15
# PLATFORM_SETUP_FEE=4990
# JSON arrays of partial overrides keyed by code (see
# apps/server/src/domains/billing/platform-pricing.config.ts):
# PLATFORM_PLANS=[{"code":"club","priceMonthly":6490}]
# PLATFORM_MODULES=[{"code":"VIDEO","priceMonthly":1290,"includedStorageGb":50}]
# Trial guards (a club costs us money only during its trial): VIDEO caps, the
# e-mails a trial club may send to people (sign-in codes never count), the trial
# days the owner is reminded on, archiving after a long suspension.
# PLATFORM_TRIAL_VIDEO_STORAGE_GB=2
# PLATFORM_TRIAL_VIDEO_VIEW_HOURS=10
# PLATFORM_TRIAL_EMAIL_LIMIT=100
# PLATFORM_TRIAL_REMINDER_DAYS=23,28
# PLATFORM_ARCHIVE_AFTER_DAYS=30
# «Пробный период с картой» default (the console overrides it per club) and the
# refunded check that binds the card, rubles.
# PLATFORM_CARD_TRIAL_ENABLED=false
# PLATFORM_CARD_CHECK_AMOUNT=1
# Console «стоимость пробного периода» rates, rubles.
# PLATFORM_COST_STORAGE_GB_MONTH=3
# PLATFORM_COST_VIEW_HOUR=2
# PLATFORM_COST_EMAIL=0.1
# PLATFORM_COST_ACTIVE_MEMBER_MONTH=1
# Card payments and autopay for clubs paying ClubSpace: the platform's OWN
# YooKassa shop (not a club's). Both set = owners pay by card on «Тариф» and
# renewals are charged from the saved card; unset = only the console's manual
# «отметить оплату». Register the webhook <ROOT_URL>/payments/webhooks/platform/yookassa
# (events payment.succeeded, payment.canceled) in the shop. deploy/README.md.
# PLATFORM_YOOKASSA_SHOP_ID=
# PLATFORM_YOOKASSA_SECRET_KEY=
# 54-ФЗ receipt: vat_code (1 = без НДС … 11 = 22%), tax_system_code for a shop
# with several tax systems; PLATFORM_RECEIPT_ENABLED=false only without online-kassa.
# PLATFORM_RECEIPT_VAT_CODE=1
# PLATFORM_RECEIPT_TAX_SYSTEM_CODE=
# PLATFORM_RECEIPT_ENABLED=true
# The platform's contract with clubs (docs/legal/README.md): editions of the
# offer (app /legal/offer) and the data processing instruction (/legal/dpa),
# named by their effective date. Bump one when its text changes (deploy the
# client with the new text first): club owners get a banner and
# PLATFORM_LEGAL_ACCEPT_GRACE_DAYS to accept, then payments, card binding and
# module connection are refused until they do.
# PLATFORM_OFFER_VERSION=2026-11-01
# PLATFORM_DPA_VERSION=2026-11-01
# PLATFORM_LEGAL_ACCEPT_GRACE_DAYS=14
# The seller's requisites on /legal/requisites and in the offer («заполняется»
# until set). Card payments and autopay of clubs stay OFF (with a boot
# warning) until NAME, INN, OGRNIP, ADDRESS, BANK_NAME, BIK and ACCOUNT are
# set; CORR_ACCOUNT, EMAIL and PHONE are optional.
# PLATFORM_SELLER_NAME=
# PLATFORM_SELLER_INN=
# PLATFORM_SELLER_OGRNIP=
# PLATFORM_SELLER_ADDRESS=
# PLATFORM_SELLER_BANK_NAME=
# PLATFORM_SELLER_BIK=
# PLATFORM_SELLER_ACCOUNT=
# PLATFORM_SELLER_CORR_ACCOUNT=
# PLATFORM_SELLER_EMAIL=
# PLATFORM_SELLER_PHONE=
