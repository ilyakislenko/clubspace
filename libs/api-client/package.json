{
  "name": "@bjj-academy/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@bjj-academy/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "tslib": "^2.3.0"
  },
  "nx": {
    "targets": {
      "types:generate": {
        "executor": "nx:run-commands",
        "dependsOn": ["@bjj-academy/server:open-api:generate"],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "openapi-ts -i open-api.json -p @hey-api/typescript -o libs/api-client/src/openapi"
        }
      }
    }
  }
}
