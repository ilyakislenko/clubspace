{
  "name": "@clubspace/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@clubspace/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "@clubspace/source": "./src/openapi/schemas/schemas.gen.ts",
      "types": "./dist/openapi/schemas/schemas.gen.d.ts",
      "import": "./dist/openapi/schemas/schemas.gen.js",
      "default": "./dist/openapi/schemas/schemas.gen.js"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "tslib": "^2.3.0"
  },
  "nx": {
    "targets": {
      "types:generate": {
        "executor": "nx:run-commands",
        "dependsOn": ["@clubspace/server:open-api:generate"],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "openapi-ts -i open-api.json -p @hey-api/typescript -o libs/api-client/src/openapi && openapi-ts -f libs/api-client/openapi-ts.config.ts"
        }
      },
      "test": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "libs/api-client/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
