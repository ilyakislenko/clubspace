SERVER_PORT=3000
DEBUG=1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bjj-academy?schema=public

# Used at bootstrap to create the super admin account.
SUPER_ADMIN_EMAIL=admin@super.com
SUPER_ADMIN_PASSWORD=change-me

# JWT settings
JWT_ISSUER_URL=http://localhost:3000
JWT_AUDIENCE_URL=http://localhost:3000
# Access token TTL in seconds. 15 minutes is a reasonable default.
JWT_ACCESS_TOKEN_TTL=900
# Refresh token TTL in seconds. 30 days here.
JWT_REFRESH_TOKEN_TTL=2592000
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-a-random-string

ROOT_URL=http://localhost:3000
ORGANIZATION_NAME=BJJ_Academy

# SMTP transport for outgoing email (auth codes, notifications)
SMTP_URL=smtp://maildev:maildev@localhost:1025
SMTP_NO_REPLY_EMAIL=noreply@bjj-academy.com

# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=replace-me-with-a-random-32-byte-hex

# Re-send code throttle (seconds)
COMPLETE_CODE_TIMEOUT=60

# S3 / MinIO storage for raw videos and HLS segments
S3_UPLOAD_BUCKET_URL=http://localhost:9000
S3_REGION=us-west-1
S3_BUCKET_NAME=bjj-academy
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# true for MinIO / R2 path-style; false for AWS S3
S3_FORCE_PATH_STYLE=true
S3_ACCELERATE_URL=
S3_ACL=public-read
S3_MAX_FILE_SIZE=
S3_MAX_FILES=

# Public env exposed to Next.js apps (admin, client)
NEXT_PUBLIC_MINIO_BUCKET=bjj-academy
NEXT_PUBLIC_API_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins.
# In production, list only your real domains, never use "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4201

# Sentry (optional). Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
