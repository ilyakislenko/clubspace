SERVER_PORT=3000
DEBUG=1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clubspace?schema=public

# The platform owner. On every boot the server makes sure an account with this
# address exists and has platform-admin rights, so pointing it at a different
# address promotes that one on the next restart. Sign-in is by emailed code —
# there is no password to set.
SUPER_ADMIN_EMAIL=admin@super.com

# Store review account (Google Play / App Store). Reviewers can't read our mail,
# so this one email signs in with a fixed 6-digit code instead. Set BOTH or
# neither; the code must not be guessable (no 123456, 111111, ...) and the email
# must differ from SUPER_ADMIN_EMAIL. Keep it set: every app update is reviewed.
# STORE_REVIEW_EMAIL=review@example.com
# Generate: LC_ALL=C tr -dc 0-9 </dev/urandom | head -c6
# STORE_REVIEW_CODE=REPLACE_WITH_6_RANDOM_DIGITS
# Demo club the reviewer is made an ACTIVE student of on every review sign-in.
# STORE_REVIEW_WORKSPACE_KEY=demo_club

# Opt-in sample club for local development (grappling categories, belt tags,
# demo plans). Leave unset/false: real clubs are created from the platform
# console at /platform in the admin.
SEED_DEMO_WORKSPACE=false
DEFAULT_WORKSPACE_ADMIN_EMAIL=admin@clubspace.example.com

# JWT settings
JWT_ISSUER_URL=http://localhost:3000
JWT_AUDIENCE_URL=http://localhost:3000
# Access token TTL in seconds. 15 minutes is a reasonable default.
JWT_ACCESS_TOKEN_TTL=900
# Refresh token TTL in seconds. 30 days here.
JWT_REFRESH_TOKEN_TTL=2592000
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-a-random-string

ROOT_URL=http://localhost:3000
# Where people open the admin and the member web app (links in e-mails, the
# join QR code). ROOT_URL is the API, not one of them.
ADMIN_URL=http://localhost:4200
APP_URL=http://localhost:8081
ORGANIZATION_NAME=BJJ_Academy

# SMTP transport for outgoing email (auth codes, notifications)
SMTP_URL=smtp://maildev:maildev@localhost:1025
SMTP_NO_REPLY_EMAIL=noreply@clubspace.example.com

# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=replace-me-with-a-random-32-byte-hex

# Re-send code throttle, in milliseconds (environment.completeCodeTimeout; 60000 = one minute)
COMPLETE_CODE_TIMEOUT=60000

# S3 / MinIO storage for raw videos and HLS segments
S3_UPLOAD_BUCKET_URL=http://localhost:9000
S3_REGION=us-west-1
S3_BUCKET_NAME=clubspace
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# true for MinIO / R2 path-style; false for AWS S3
S3_FORCE_PATH_STYLE=true
S3_ACCELERATE_URL=
S3_ACL=public-read
S3_MAX_FILE_SIZE=
S3_MAX_FILES=

# Video worker. Uncomment to override — an empty `NAME=` is not "unset" to the
# env parser and fails the number checks at boot.
# Hard ceiling on a single ffmpeg run, in ms (default 30 min). With the default
# TRANSCODE_CONCURRENCY=1 a hung encode stops the whole queue until it is
# killed. Raise it only if you genuinely process very long footage.
# VIDEO_TRANSCODE_TIMEOUT_MS=1800000
# Parallel transcodes in the worker.
# TRANSCODE_CONCURRENCY=1
# Largest video upload in MiB (default and maximum 5120 — one S3 PUT). Read by
# both the server and the worker.
# MAX_VIDEO_UPLOAD_MB=5120
# Longest video the worker accepts, in minutes.
# MAX_VIDEO_DURATION_MINUTES=240
# The worker probes uploads with ffprobe before transcoding. Defaults:
# `ffprobe` from PATH, and the ffmpeg-static binary for ffmpeg.
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# Where the server and worker send their own storage calls when that differs
# from S3_UPLOAD_BUCKET_URL (prod: http://minio:9000). Unset = same URL.
# S3_INTERNAL_URL=http://minio:9000

# Public env exposed to Next.js apps (admin, client)
NEXT_PUBLIC_MINIO_BUCKET=clubspace
NEXT_PUBLIC_API_URL=http://localhost:3000
# Public member web app (apps/client) — the admin links its /legal/* pages.
# Empty = derived from an api.<domain> NEXT_PUBLIC_API_URL as app.<domain>;
# set it when running apps/client locally (its dev URL).
NEXT_PUBLIC_APP_URL=
# apps/client runtime: its own public address (canonical / Open Graph /
# sitemap URLs on the landing). The landing's «Попробовать» link reuses
# ADMIN_URL above (<ADMIN_URL>/sign-up). Compose sets both in production.
# SITE_URL=http://localhost:4201

# Comma-separated list of allowed CORS origins.
# In production, list only your real domains, never use "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4201

# Brand preset for this instance (admin + client UIs use it before login).
# Allowed values: grappling | fitness | yoga | generic. Empty = generic.
NEXT_PUBLIC_BRAND=grappling

# Edition of the personal-data consent (152-ФЗ). One value drives both the
# server gate and the client's /legal/consent page. Bumping it makes every user
# re-accept the consent in the apps on next request.
CONSENT_VERSION=2026-11-01
NEXT_PUBLIC_CONSENT_VERSION=2026-11-01

# Sentry (optional). Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Frontend Sentry — picked up by admin + client (Next.js).
# NEXT_PUBLIC_ values are exposed to the browser; only put a public DSN here.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Platform billing of clubs: monthly price by ACTIVE members (Старт ≤50 2 990,
# Клуб ≤100 5 990, Про ≤200 9 990, Бизнес ≤400 16 990, Сеть 16 990 + 35 ₽ за
# каждого сверх 400), paid modules VIDEO / ONLINE_PAYMENTS / BRANDED_APP, annual
# prepay discount and a one-time setup fee. Whole rubles. Payment collection is
# manual: the platform console (/platform) marks a period paid.
# false = self-hosted install: every module on, no trial expiry, no banners.
PLATFORM_BILLING_ENABLED=true
# Public «Создать клуб» wizard at <admin>/sign-up (30-day trial, one per account).
SELF_SERVE_SIGNUP_ENABLED=false
# PLATFORM_TRIAL_DAYS=30
# PLATFORM_GRACE_DAYS=7
# PLATFORM_ANNUAL_DISCOUNT_PERCENT=15
# PLATFORM_SETUP_FEE=4990
# JSON arrays of partial overrides keyed by code (see
# apps/server/src/domains/billing/platform-pricing.config.ts):
# PLATFORM_PLANS=[{"code":"club","priceMonthly":6490}]
# PLATFORM_MODULES=[{"code":"VIDEO","priceMonthly":1290,"includedStorageGb":50}]
# Trial guards (a club costs us money only during its trial): VIDEO caps, the
# e-mails a trial club may send to people (sign-in codes never count), the trial
# days the owner is reminded on, archiving after a long suspension.
# PLATFORM_TRIAL_VIDEO_STORAGE_GB=2
# PLATFORM_TRIAL_VIDEO_VIEW_HOURS=10
# PLATFORM_TRIAL_EMAIL_LIMIT=100
# PLATFORM_TRIAL_REMINDER_DAYS=23,28
# PLATFORM_ARCHIVE_AFTER_DAYS=30
# «Пробный период с картой» default (the console overrides it per club) and the
# refunded check that binds the card, rubles.
# PLATFORM_CARD_TRIAL_ENABLED=false
# PLATFORM_CARD_CHECK_AMOUNT=1
# Console «стоимость пробного периода» rates, rubles.
# PLATFORM_COST_STORAGE_GB_MONTH=3
# PLATFORM_COST_VIEW_HOUR=2
# PLATFORM_COST_EMAIL=0.1
# PLATFORM_COST_ACTIVE_MEMBER_MONTH=1
# Card payments and autopay for clubs paying ClubSpace: the platform's OWN
# YooKassa shop (not a club's). Both set = owners pay by card on «Тариф» and
# renewals are charged from the saved card; unset = only the console's manual
# «отметить оплату». Register the webhook <ROOT_URL>/payments/webhooks/platform/yookassa
# (events payment.succeeded, payment.canceled) in the shop. deploy/README.md.
# PLATFORM_YOOKASSA_SHOP_ID=
# PLATFORM_YOOKASSA_SECRET_KEY=
# 54-ФЗ receipt: vat_code (1 = без НДС … 11 = 22%), tax_system_code for a shop
# with several tax systems; PLATFORM_RECEIPT_ENABLED=false only without online-kassa.
# PLATFORM_RECEIPT_VAT_CODE=1
# PLATFORM_RECEIPT_TAX_SYSTEM_CODE=
# PLATFORM_RECEIPT_ENABLED=true
