{
  "name": "@bjj-academy/bjj-academy-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/bjj-academy-mobile",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:pwa": "node scripts/build-pwa.mjs",
    "serve:pwa": "node scripts/serve-pwa.mjs",
    "start:web": "node scripts/sync-web-assets.mjs && expo start --web"
  },
  "dependencies": {
    "@expo/metro-config": "*",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "*",
    "@react-navigation/native-stack": "*",
    "@testing-library/react-native": "*",
    "expo": "~54.0.34",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "expo-video": "~3.0.16",
    "jest-expo": "*",
    "metro-config": "*",
    "metro-resolver": "*",
    "react": "*",
    "react-dom": "19.1.0",
    "react-native": "*",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-web": "*",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "sharp": "^0.34.5"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "apps/bjj-academy-mobile/jest.config.cjs",
          "passWithNoTests": true
        }
      }
    }
  }
}
