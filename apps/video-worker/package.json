{
  "name": "@clubspace/video-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/dist/apps/video-worker"
        ],
        "options": {
          "command": "tsc -p apps/video-worker/tsconfig.app.json && cp apps/video-worker/package.json dist/apps/video-worker/package.json",
          "cwd": "{workspaceRoot}"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import tsx apps/video-worker/src/main.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "backfill-thumbnails": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import tsx apps/video-worker/scripts/backfill-thumbnails.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "backfill-chapters": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import tsx apps/video-worker/scripts/backfill-chapters.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "backfill-transcripts": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import tsx apps/video-worker/scripts/backfill-transcripts.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "backfill-techniques": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import tsx apps/video-worker/scripts/backfill-techniques.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "// targets": "to see all targets run: nx show project @clubspace/video-worker --web"
  }
}
