{
  "name": "@clubspace/client",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "next": "~16.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "targets": {
      "serve": {
        "executor": "@nx/next:server",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@clubspace/client:build",
          "dev": true
        },
        "configurations": {
          "development": {
            "buildTarget": "@clubspace/client:build:development",
            "dev": true
          },
          "production": {
            "buildTarget": "@clubspace/client:build:production",
            "dev": false
          }
        }
      },
      "build": {
        "executor": "@nx/next:build",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "outputPath": "{workspaceRoot}/dist/apps/client"
        },
        "configurations": {
          "development": {
            "outputPath": "{workspaceRoot}/dist/apps/client"
          },
          "production": {}
        }
      }
    }
  }
}
