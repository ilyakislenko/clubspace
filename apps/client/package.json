{
  "name": "@bjj-academy/client",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "next": "~16.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
"nx": {
  "targets": {
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "@bjj-academy/client:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "@bjj-academy/client:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "@bjj-academy/client:build:production",
          "dev": false
        }
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "{workspaceRoot}/dist/apps/client"
      },
      "configurations": {
        "development": { "outputPath": "{workspaceRoot}/dist/apps/client" },
        "production": {}
      }
    },
    "sdk:generate": {
  "executor": "nx:run-commands",
  "dependsOn": ["@bjj-academy/server:open-api:generate"],
  "options": {
    "cwd": "{workspaceRoot}",
    "command": "openapi-ts -i open-api.json -c @hey-api/client-axios -o apps/client/src/shared/sdk"
  }
}

  }
}


}
