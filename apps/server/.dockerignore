**/*.test.ts
**/__tests__
**/__mocks__

# Other apps that don't belong in the server image. We keep their
# package.json files reachable so `npm ci` can satisfy the workspace
# graph, but skip their source (nx won't compile them for the server
# target anyway).
apps/admin/.next
apps/admin/dist
apps/admin/src
apps/admin/public
apps/mobile/android
apps/mobile/ios
apps/mobile/src
apps/mobile/assets
apps/mobile/dist
apps/client/src
apps/client/dist
apps/server-e2e/src
apps/video-worker/src
apps/video-worker/dist

# Docs / reference
README.md
TESTS.md
reference
docs

# Local docker artefacts
docker-compose.yml
docker-compose.*.yml
deploy
