generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/prisma/generated"
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

generator client_runtime {
  provider = "prisma-client"
  output   = "../../../libs/prisma-client/src/generated"
}

datasource db {
  provider   = "postgresql"
  extensions = []
}

enum LanguageEnum {
  EN
  RU
  KZ
  ZH

}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum WorkspaceType {
  GRAPPLING
  FITNESS
  YOGA
  CUSTOM
}

enum TfaMethodTypeEnum {
  GOOGLE
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  INVITED
  BLOCKED
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum NotificationTypeEnum {
  EMAIL
  PUSH
  TELEGRAM
}

model Workspace {
  id         String        @id @default(uuid()) @db.Uuid
  key        String        @unique @db.VarChar(50) // "grappling_academy", "bjj_school"
  name       String        @db.VarChar(255)
  type       WorkspaceType @default(GRAPPLING)

  isActive   Boolean       @default(true)

  ownerId String @db.Uuid
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos     Video[]
  categories Category[]
  tagEntities TagEntity[]
  courses    Course[]
  subscriptions Subscription[]
  members       WorkspaceMember[]
  plans         Plan[]
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email                    String       @unique
  phone                    String?      @unique
  password                 String?
  language                 LanguageEnum @default(RU)
  completeCode             String?
  completeCodeNextResendAt DateTime?
  googleId                 String?      @unique
  appleId                  String?      @unique
  status                   UserStatus   @default(ACTIVE)

  isSuperAdmin Boolean @default(false)

  firstname       String?
  lastname        String?
  dateOfBirth     DateTime?
  description     String?
  profilePhotoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastSeenAt        DateTime                               @default(now())

  refreshTokens RefreshToken[]
  tfaMethod          TfaMethod[]
  workspaceMemberships WorkspaceMember[]
  files File[]
  notifications Notification[]
  notificationPreferences NotificationPreferences?
  firebaseDevices FirebaseDevice[]
  @@index([isSuperAdmin])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationTypeEnum
  topic String @db.VarChar(255)
  message String @db.Text
  link String? @db.Text
  metadata Json?
  sentPayload Json?

  sent Boolean @default(false)
  sentAt DateTime?
  error String?
  seen Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model NotificationPreferences {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled Boolean @default(false)
  pushEnabled Boolean @default(false)
  telegramEnabled Boolean @default(false)

  email String? @db.VarChar(255)
  telegramAccount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FirebaseDevice {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @db.Text
  timezone String @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token], name: "userId_token")
  @@index([userId])
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String
  mimeType     String
  size         Int
  eTag         String?
  bucket       String
  location     String
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model WorkspaceMember {
  id String @id @default(uuid()) @db.Uuid
  
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // РОЛЬ в workspace
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])
  
  // СТАТУС участия
  status MemberStatus @default(ACTIVE)
  
  // ПОДПИСКА (если есть)
  subscriptionId String?       @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, workspaceId]) // Пользователь только раз в workspace
  @@index([workspaceId])
  @@index([userId])
  @@index([roleId])
}

model Video {
  id          String  @id @default(uuid()) @db.Uuid
  
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  title       String  @db.VarChar(255)
  description String? @db.Text
  url         String  @db.Text

  status       String @default("uploading") @db.VarChar(50)
  isPublic     Boolean @default(false)
  rawBucket    String? @db.VarChar(255)
  rawKey       String? @db.VarChar(512)
  hlsBucket    String? @db.VarChar(255)
  hlsMasterKey String? @db.VarChar(512)
  errorMessage String? @db.Text

  duration     Int?
  thumbnailUrl String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags       VideoTag[]
  categories VideoCategory[]
  courses    CourseVideo[]
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model TagEntity {
  id String @id @default(uuid()) @db.Uuid
  
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  
  type String @db.VarChar(50)
  
  name String @db.VarChar(255)
  slug String @db.VarChar(255)
  
  description String? @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  primaryTags   VideoTag[] @relation("Primary")
  secondaryTags VideoTag[] @relation("Secondary")
  contextTags   VideoTag[] @relation("Context")
  
  @@unique([type, slug, workspaceId])
  @@index([workspaceId, type])
}

model VideoTag {
  id String @id @default(uuid()) @db.Uuid

  videoId     String @db.Uuid
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  primaryId String    @db.Uuid
  primary   TagEntity @relation("Primary", fields: [primaryId], references: [id], onDelete: Restrict)
 
  secondaryId String?    @db.Uuid
  secondary   TagEntity? @relation("Secondary", fields: [secondaryId], references: [id], onDelete: SetNull)


  contextId String?    @db.Uuid
  context   TagEntity? @relation("Context", fields: [contextId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@unique([videoId, primaryId, secondaryId, contextId])
  @@index([primaryId])
  @@index([primaryId, secondaryId])
  @@index([primaryId, contextId])
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  
  name String @db.VarChar(255)
  slug String @db.VarChar(255)
  
  parentId String?   @db.Uuid
  parent   Category? @relation("Tree", fields: [parentId], references: [id])
  children Category[] @relation("Tree")
  
  order Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  videos VideoCategory[]
  
  @@unique([slug, workspaceId, parentId])
  @@index([workspaceId])
}

model VideoCategory {
  videoId    String   @db.Uuid
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  order Int @default(0)
  
  @@id([videoId, categoryId])
}

model Course {
  id String @id @default(uuid()) @db.Uuid
  
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  
  title String @db.VarChar(255)
  slug  String @db.VarChar(255)
  
  description  String? @db.Text
  thumbnailUrl String?

  status            String? @db.VarChar(50)
  accessLevel       String? @db.VarChar(50)
  level             String? @db.VarChar(50)
  lockedProgression Boolean           @default(false)
  tags              String[]          @default([])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  videos CourseVideo[]
  
  @@unique([slug, workspaceId])
}

model CourseVideo {
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  order       Int
  lessonTitle String? @db.VarChar(255)
  stepType    String?        @db.VarChar(50)
  isOptional  Boolean        @default(false)
  
  @@id([courseId, videoId])
  @@unique([courseId, order])
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String   @unique @db.VarChar(128)
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime

  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// ROLE & PERMISSIONS 
// ═══════════════════════════════════════════════════════════════

model Role {
  id String @id @default(uuid()) @db.Uuid
  
  name      String  @unique @db.VarChar(100)
  superuser Boolean @default(false)
  editable  Boolean @default(true)
  
  members     WorkspaceMember[]
  permissions RolePermission[]
  
}

model RolePermission {
  role      Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String      @db.Uuid
  
  feature   RoleFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String      @db.Uuid
  
  allowed   Boolean     @default(false)
  
  @@id([roleId, featureId])
  @@index([roleId])
  @@index([featureId])
}

model RoleFeature {
  id          String  @id @default(uuid()) @db.Uuid
  
  key         String  @unique @db.VarChar(100) // "videos.create", "users.manage"
  description String? @db.Text
  group       String? @db.VarChar(50)          // "videos", "users", "workspace"
  alwaysIn    Boolean?
  
  permissions RolePermission[]
}

model TfaRequestGroup {
  id             String          @id @default(uuid()) @db.Uuid
  alwaysEnabled  Boolean         @default(false)
  key            String          @unique
  description    String?
  tfaPermissions TfaPermission[]

}

model TfaPermission {
  group    TfaRequestGroup @relation(fields: [groupId], references: [id])
  groupId  String          @db.Uuid
  method   TfaMethod       @relation(fields: [methodId], references: [id])
  methodId String          @db.Uuid
  enabled  Boolean         @default(false)

  @@id([groupId, methodId])
}

model TfaMethod {
  id      String            @id @default(uuid()) @db.Uuid
  type    TfaMethodTypeEnum
  enabled Boolean           @default(false)
  secret  String

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id])
  tfaPermissions TfaPermission[]

}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

// ═══════════════════════════════════════════════════════════════
// SUBSCRIPTION
// ═══════════════════════════════════════════════════════════════

model Subscription {
  id String @id @default(uuid()) @db.Uuid
  
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  
  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])
  
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  
  amountPaid Int
  currency   String @db.Char(3)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  members WorkspaceMember[]
  @@index([workspaceId])
  @@index([status])
  @@index([endDate])
}

model Plan {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String? @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  
  name        String @db.VarChar(255)
  description String? @db.Text
  price       Int
  currency    String @db.Char(3)
  
  subscriptions Subscription[]
   @@index([workspaceId])
}

model AuditEvent {
  id          String  @id @default(uuid()) @db.Uuid

  workspaceId String? @db.Uuid
  actorId     String? @db.Uuid
  actorEmail  String?

  action      String  @db.VarChar(64)
  targetType  String  @db.VarChar(64)
  targetId    String? @db.VarChar(128)
  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@index([action])
}
