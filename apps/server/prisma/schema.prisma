  name      String  @unique @db.VarChar(100)
  superuser Boolean @default(false)
  editable  Boolean @default(true)

  members     WorkspaceMember[]
  permissions RolePermission[]
}

model RolePermission {
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid

  feature   RoleFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String      @db.Uuid

  allowed Boolean @default(false)

  @@id([roleId, featureId])
  @@index([roleId])
  @@index([featureId])
}

model RoleFeature {
  id String @id @default(uuid()) @db.Uuid

  key         String   @unique @db.VarChar(100) // "videos.create", "users.manage"
  description String?  @db.Text
  group       String?  @db.VarChar(50) // "videos", "users", "workspace"
