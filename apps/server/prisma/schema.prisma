generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/prisma/generated"
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

generator client_runtime {
  provider            = "prisma-client"
  output              = "../../../libs/prisma-client/src/generated"
  // The video worker runs this client as plain Node ESM, which needs explicit
  // extensions on relative imports.
  importFileExtension = "js"
}

datasource db {
  provider   = "postgresql"
  extensions = []
}

enum LanguageEnum {
  EN
  RU
  KZ
  ZH
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum WorkspaceType {
  GRAPPLING
  FITNESS
  YOGA
  CUSTOM
}

enum TfaMethodTypeEnum {
  GOOGLE
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  INVITED
  BLOCKED
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

// How a subscription (abonement purchase) was recorded. MANUAL = a coach/owner
// marked it in the admin. GATEWAY = the member paid online and the provider's
// webhook created it (see Payment).
enum SubscriptionSource {
  MANUAL
  GATEWAY
}

enum NotificationTypeEnum {
  EMAIL
  PUSH
  TELEGRAM
}

// Dedup ledger for notification fan-outs. Before fanning a notification
// out, the producer INSERTs (kind, refId) here; on conflict it skips the
// fan-out. Lets concurrent workers and restarts re-run the same job
// without duplicating push messages.
//   kind   — 'session.reminder' | 'event.reminder' | 'exception.notify' | …
//   refId  — slotId+date for sessions, eventId, exceptionId, …
// Time-bounded kinds are purged nightly (DISPATCH_LOG_RETENTION_DAYS in
// scheduler/data-purge.service.ts); one-off kinds are kept forever.
model NotificationDispatchLog {
  kind         String   @db.VarChar(64)
  refId        String   @db.VarChar(128)
  dispatchedAt DateTime @default(now())

  @@id([kind, refId])
  @@index([dispatchedAt])
}

model Workspace {
  id   String        @id @default(uuid()) @db.Uuid
  key  String        @unique @db.VarChar(50) // "grappling_academy", "bjj_school"
  name String        @db.VarChar(255)
  type WorkspaceType @default(GRAPPLING)

  isActive Boolean @default(true)

  // When true, every coach in this workspace sees all groups + students,
  // not just their own. Default false because most clubs want privacy
  // between coaches; set true for tight teams that prefer transparency.
  coachSeesAllGroups Boolean @default(false)

  // Club-wide switch for the attendance leaderboard. On by default (a gym
  // usually wants the motivation); the owner can turn the whole feature off,
  // and an individual member can still opt out via WorkspaceMember below.
  leaderboardEnabled Boolean @default(true)

  // App-section feature flags. Each toggles whether a whole block appears in
  // the member mobile app, so a club can hide features that overcomplicate the
  // app early on. All default ON — the club opts specific blocks OUT.
  // Surfaced to the app via get-my-workspaces; toggled from the admin via
  // update-workspace-settings. (leaderboardEnabled above is the original of
  // this family.)
  announcementsEnabled Boolean @default(true)
  ranksEnabled         Boolean @default(true)
  attendanceEnabled    Boolean @default(true)
  subscriptionEnabled  Boolean @default(true)
  scheduleEnabled      Boolean @default(true)
  groupsEnabled        Boolean @default(true)
  eventsEnabled        Boolean @default(true)
  guestVisitsEnabled   Boolean @default(true)
  videosEnabled        Boolean @default(true)
  achievementsEnabled  Boolean @default(true)
  journalEnabled       Boolean @default(true)

  // IANA timezone the schedule slots are interpreted in. Slots store
  // wall-clock times ("19:00") so DST shifts don't break them; this is
  // what we project against when computing "the next Tuesday at 19:00"
  // for a given user. Cross-workspace HQ views can aggregate by computing
  // each workspace's schedule in its own zone first.
  timezone String @default("Europe/Moscow") @db.VarChar(64)

  // «Принимать без подтверждения»: a code join creates an ACTIVE membership
  // instead of a pending (INVITED) request. Off by default. Never applies to the
  // unauthenticated send-auth-code workspaceKey path (anyone can request a code
  // for any e-mail there — auto-approving would let strangers fill the roster).
  joinAutoApprove Boolean @default(false)

  // «О клубе»: contacts/links/rules the club shows its students in the app.
  // contacts = [{label, phone}] (phone normalised to +7…), links = [{label, url}]
  // (http/https only). Parsed defensively on read (club-about/schemas.ts).
  aboutContacts  Json      @default("[]")
  aboutLinks     Json      @default("[]")
  aboutRules     String?   @db.Text
  aboutUpdatedAt DateTime?
  city String? @db.VarChar(120)
  // «Публичная страница»: what anyone sees on app.<domain>/c/<slug>, on the
  // /join/<code> preview and in club search — never members or ids. The logo
  // lives under workspaces/<id>/logo/ (a private prefix; handed out presigned).
  // isListed opts the club into search and /c/<slug>; off by default.
  publicDescription String? @db.Text
  logoKey           String? @db.VarChar(255)
  isListed          Boolean @default(false)

  // The generated in-person demo club (domains/demo, docs/demo.md). Only a
  // club carrying this flag AND the demo key may be wiped by «Сбросить демо».
  isDemo Boolean @default(false)

  // «Запись на занятие» (groups in BOOKING mode, docs/design/2026-11-01-class-booking.md):
  // booking opens bookingWindowDays before a class (club calendar), a member
  // cancels freely until bookingCancelHours before its start. Later cancels and
  // no-shows are recorded; they burn a class from the abonement a visit would
  // use when the matching switch is on. A group may override window/deadline.
  bookingWindowDays     Int     @default(14)
  bookingCancelHours    Int     @default(12)
  bookingLateCancelBurn Boolean @default(true)
  bookingNoShowBurn     Boolean @default(true)

  ownerId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos        Video[]
  categories    Category[]
  tagEntities   TagEntity[]
  courses       Course[]
  subscriptions Subscription[]
  subscriptionFreezes SubscriptionFreeze[]
  subscriptionFreezeRequests SubscriptionFreezeRequest[]
  members       WorkspaceMember[]
  joinCodeRow   WorkspaceJoinCode?
  publicSlugRow WorkspacePublicSlug?
  plans         Plan[]
  watched       VideoWatched[]
  favorites     VideoFavorite[]
  gyms          Gym[]
  directions    Direction[]
  directionManagers DirectionManager[]
  groups        Group[]
  events        WorkspaceEvent[]

  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[] @relation("WorkspaceAttendanceRecords")
  dropInBookings     DropInBooking[]
  classOccurrences   ClassOccurrence[]
  classBookings      ClassBooking[]
  personalTrainingCoaches  PersonalTrainingCoach[]
  personalTrainingRequests PersonalTrainingRequest[]

  rankLadders    RankLadder[]
  rankPromotions RankPromotion[]

  announcements Announcement[]

  journalEntries TrainingJournalEntry[]

  achievements Achievement[]
  retentionContacts MemberRetentionContact[]
  // «Аналитика» snapshots (docs/design/2026-11-01-smart-analytics.md).
  analyticsRun             AnalyticsRun?
  analyticsMembers         AnalyticsMemberSnapshot[]
  analyticsMemberGroups    AnalyticsMemberGroupStat[]
  analyticsSlotOccurrences AnalyticsSlotOccurrence[]

  rankGradings          RankGrading[]
  rankGradingCandidates RankGradingCandidate[]

  // Platform subscription + trial state (SaaS side: what the club pays
  // ClubSpace). Created lazily on first read for clubs that predate billing.
  billing WorkspaceBilling?
  // Paid modules (VIDEO / ONLINE_PAYMENTS / BRANDED_APP): paid, comped or off.
  moduleEntitlements WorkspaceModuleEntitlement[]
  // Hours of video watched per calendar month (VIDEO module metering).
  videoViewingMonths VideoViewingMonth[]
  // What the club paid ClubSpace (card payments, autopay renewals, refunds).
  platformPayments PlatformPayment[]
  // App-section switches the platform pinned on or off for the club.
  featureLocks WorkspaceFeatureLock[]
  // «Запросить помощь с подключением»: requests to the platform's onboarding team.
  onboardingHelpRequests OnboardingHelpRequest[]
  // Acceptances of the platform's offer and data processing instruction.
  legalAcceptances ClubLegalAcceptance[]
  paymentSettings WorkspacePaymentSettings?
  payments        Payment[]

  invitations WorkspaceInvitation[]

  guardianshipInvites Guardianship[]

  clubImports ClubImport[]

  // ИИ-ассистент (MCP, docs/mcp.md): personal access tokens and the owner's
  // acceptances of the personal-data transfer warning.
  aiAccessTokens            AiAccessToken[]
  aiDataTransferAcceptances AiDataTransferAcceptance[]

  @@index([isListed])
}

model User {
  id String @id @default(uuid()) @db.Uuid

  // Null for a dependent: a child profile with no login of its own (see
  // Guardianship). Postgres keeps NULLs out of the unique index, so any number
  // of dependents coexist, and the OTP sign-in resolves an address by exact
  // match, so a dependent can never sign in.
  email                    String?      @unique
  phone                    String?      @unique
  password                 String?
  language                 LanguageEnum @default(RU)
  completeCode             String?
  completeCodeNextResendAt DateTime?
  // Time the current OTP was issued. Used to enforce a 15-minute TTL
  // at sign-in time so a leaked code can't be redeemed days later.
  completeCodeIssuedAt     DateTime?
  // Per-account brute-force ceiling across every address: MAX wrong codes ->
  // lockedUntil set to now + 15 minutes. The tighter per-address limit lives
  // in SignInThrottle, so one stranger can't lock a known account out.
  // Reset on successful sign-in.
  signInFailedAttempts     Int       @default(0)
  signInLockedUntil        DateTime?
  // Embedded in every access token (`sv`); AuthGuard refuses a token whose
  // version is behind. Bumped to end every session at once: sign out
  // everywhere, email change, account deletion.
  sessionVersion           Int       @default(0)
  googleId                 String?      @unique
  appleId                  String?      @unique
  status                   UserStatus   @default(ACTIVE)

  isSuperAdmin Boolean @default(false)
  // Created by the demo generator. Demo fixed-code sign-in and the reset only
  // ever act on accounts with this flag.
  isDemo       Boolean @default(false)

  firstname       String?
  lastname        String?
  dateOfBirth     DateTime?
  description     String?
  profilePhotoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastSeenAt DateTime @default(now())

  // Version of the personal-data consent (152-ФЗ ст. 9) this user accepted
  // last; null until they accept. Denormalised from ConsentRecord so AuthGuard
  // gates on the row it already loads. Compared with CONSENT_VERSION.
  personalDataConsentVersion String? @db.VarChar(64)

  // Set when the user self-deletes. The row is kept (anonymized, status=DELETED)
  // so historical references — future leaderboards / results — don't gap; PII is
  // scrubbed. See UsersService.deleteAccount.
  deletedAt DateTime?

  refreshTokens           RefreshToken[]
  signInThrottles         SignInThrottle[]
  tfaMethod               TfaMethod[]
  workspaceMemberships    WorkspaceMember[]
  files                   File[]
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  firebaseDevices         FirebaseDevice[]
  webPushSubscriptions    WebPushSubscription[]
  watched                 VideoWatched[]
  favorites               VideoFavorite[]
  coachOfGroups           Group[]                  @relation("GroupCoach")
  coachAssignments        GroupCoach[]             @relation("GroupCoaches")
  managedDirections       DirectionManager[]
  eventsCoached           WorkspaceEvent[]         @relation("EventCoach")
  eventsCreated           WorkspaceEvent[]         @relation("EventCreator")
  groupMemberships        GroupMember[]

  sessionsCoached   AttendanceSession[] @relation("SessionCoach")
  sessionsCreated   AttendanceSession[] @relation("SessionCreatedBy")
  attendanceRecords AttendanceRecord[]  @relation("AttendanceUser")
  recordsMarked     AttendanceRecord[]  @relation("AttendanceMarkedBy")
  dropInBookings    DropInBooking[]
  classBookings     ClassBooking[]  @relation("ClassBookings")
  personalTrainingOffers     PersonalTrainingCoach[]
  personalTrainingsAsMember  PersonalTrainingRequest[] @relation("PersonalTrainingMember")
  personalTrainingsAsCoach   PersonalTrainingRequest[] @relation("PersonalTrainingCoach")

  rankPromotions        RankPromotion[] @relation("MemberRankPromotions")
  rankPromotionsAwarded RankPromotion[] @relation("RankPromotionAwardedBy")

  announcements Announcement[] @relation("AnnouncementAuthor")

  journalEntries TrainingJournalEntry[]

  subscriptionFreezes SubscriptionFreeze[]
  freezeRequests        SubscriptionFreezeRequest[] @relation("FreezeRequestMember")
  freezeRequestsDecided SubscriptionFreezeRequest[] @relation("FreezeRequestDecidedBy")
  retentionContacts     MemberRetentionContact[] @relation("RetentionContactMember")
  retentionContactsMade MemberRetentionContact[] @relation("RetentionContactBy")

  rankGradingsCreated    RankGrading[]          @relation("RankGradingCreatedBy")
  rankGradingCandidacies RankGradingCandidate[] @relation("RankGradingCandidates")

  consentRecords ConsentRecord[]
  payments Payment[]

  workspaceInvitations WorkspaceInvitation[]

  // Dependents this user is guardian of, and the guardians of this user when
  // it is a dependent.
  guardianOf           Guardianship[] @relation("GuardianshipGuardian")
  dependentOf          Guardianship[] @relation("GuardianshipDependent")
  guardianshipsInvited Guardianship[] @relation("GuardianshipInvitedBy")

  // ИИ-ассистент tokens this user created (bound to their role and directions).
  aiAccessTokens AiAccessToken[] @relation("AiAccessTokenCreatedBy")

  @@index([isSuperAdmin])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationTypeEnum
  topic       String               @db.VarChar(255)
  message     String               @db.Text
  link        String?              @db.Text
  metadata    Json?
  // Delivery receipt only: { ticketIds } for push, { messageId } for e-mail.
  sentPayload Json?

  sent   Boolean   @default(false)
  sentAt DateTime?
  error  String?
  seen   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inbox list and unread badge: WHERE userId [AND seen = false] ORDER BY createdAt.
  @@index([userId, seen, createdAt])
  // Pending-push recovery sweep (sent = false, type = PUSH, createdAt window).
  // Prisma can't declare a partial index and `db push` drops hand-made ones,
  // so this is the full composite; pending rows are a tiny, hot prefix of it.
  @@index([sent, type, createdAt])
  // Retention purge by age.
  @@index([createdAt])
}

model NotificationPreferences {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled    Boolean @default(false)
  pushEnabled     Boolean @default(false)
  telegramEnabled Boolean @default(false)

  // Category-level opt-outs for the in-app/push channel (default on). These
  // back the mobile Settings toggles and gate the matching producers.
  newVideosEnabled      Boolean @default(true)
  accessExpiringEnabled Boolean @default(true)
  promotionsEnabled     Boolean @default(true)
  announcementsEnabled  Boolean @default(true)
  inactivityEnabled     Boolean @default(true)
  // Monday «Аналитика за неделю» to the club's owner and admins (push + e-mail).
  analyticsDigestEnabled Boolean @default(true)

  email           String? @db.VarChar(255)
  telegramAccount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FirebaseDevice {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @db.Text
  timezone String @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token], name: "userId_token")
  @@index([userId])
}

// A browser's Web Push subscription (PWA / web build). One row per browser
// profile: the push service endpoint is unique, and a browser that signs in as
// someone else moves its row to them.
model WebPushSubscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique @db.Text
  p256dh    String  @db.VarChar(128)
  auth      String  @db.VarChar(64)
  userAgent String? @db.VarChar(512)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String
  mimeType     String
  size         Int
  eTag         String?
  bucket       String
  location     String
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Physical training location. A workspace can have several gyms; coaches
// run groups at one or more of them. Address is plain text for now —
// geocoding (lat/lng) is added later when the map screen lands.
model Gym {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String @db.VarChar(255) // "Гладиатор", "Манеж"
  address String @db.VarChar(500)

  // Optional IANA timezone of the physical gym. Falls back to the
  // workspace's timezone when null — schedule projection picks the
  // gym's tz for sessions tied to a group anchored at this gym, so a
  // multi-city club shows each gym's training in its own wall-clock.
  timezone String? @db.VarChar(64)

  lat Float?
  lng Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups Group[]
  events WorkspaceEvent[]
  personalTrainings PersonalTrainingRequest[]
  rankGradings RankGrading[]

  @@index([workspaceId])
}

// A discipline of one club under one management: «БЖЖ», «ММА», «Тайский бокс»,
// «ОФП». Optional on groups, rank ladders, achievements, events,
// announcements and course audiences — null there means club-wide, so a club
// without directions behaves exactly as before. Tariffs and sold abonements
// carry a SET of directions (PlanDirection / SubscriptionDirection; empty =
// club-wide). A member's directions are the directions of the groups they train
// in (GroupMember) or coach (GroupCoach); there is no separate membership table
// (docs/design/2026-11-01-directions.md). Children use SetNull / Cascade, but
// delete-direction refuses while anything still points here (archive with
// isActive instead), so a direction-only announcement or tariff never silently
// turns club-wide.
model Direction {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String  @db.VarChar(120)
  color    String? @db.VarChar(32) // hex for chips/tabs
  icon     String? @db.VarChar(16) // emoji
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups          Group[]
  rankLadders     RankLadder[]
  achievements    Achievement[]
  planScopes         PlanDirection[]
  subscriptionScopes SubscriptionDirection[]
  events          WorkspaceEvent[]
  announcements   Announcement[]
  courseAudiences CourseAudience[]
  managers        DirectionManager[]

  @@index([workspaceId, order])
}

// A coach who runs one direction of the club (руководитель направления БЖЖ):
// on top of the coach role they write everything tagged with this direction —
// its groups and schedule, ladders, gradings and promotions, achievements,
// events, announcements, course audience, tariffs. Club-wide rows (no
// direction) and club settings stay admin-only. One authorization rule:
// RbacService.assertCanManageDirection (docs/design/2026-11-01-direction-managers.md).
model DirectionManager {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  directionId String    @db.Uuid
  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([directionId, userId])
  @@index([workspaceId, userId])
}

// Training group. The coach owns a small set of students and the group
// is anchored to one gym. Adding schedule + assistant coaches is left
// for follow-up PRs.
model Group {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String @db.VarChar(255) // "Утренняя", "Конкурс-группа"

  // Nullable + SetNull so a gym can be deleted without forcing the admin
  // to first move every group out of it. Groups become "homeless" and
  // can be re-attached to a different gym via update-group.
  gymId String? @db.Uuid
  gym   Gym?    @relation(fields: [gymId], references: [id], onDelete: SetNull)

  // Discipline of the group; null = club-wide. Drives a member's directions.
  directionId String?    @db.Uuid
  direction   Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)

  // Primary (lead) coach. The user listed here also gets a row in
  // GroupCoach with role='primary' — having both lets one-coach queries
  // stay simple while multi-coach reads/permissions go through the
  // junction table.
  coachId String @db.Uuid
  coach   User   @relation("GroupCoach", fields: [coachId], references: [id], onDelete: Restrict)

  // «Постоянная группа» (FIXED: the roster comes, others drop in) or «Запись на
  // занятие» (BOOKING: every class is booked, limited spots, waitlist). See
  // docs/design/2026-11-01-class-booking.md.
  bookingMode GroupBookingMode @default(FIXED)
  // Spots per class in BOOKING mode; null = unlimited. A slot or a single
  // date may override it (GroupScheduleSlot.capacity, ClassOccurrence.capacity).
  capacity           Int?
  // Overrides of the club's booking window / free-cancel deadline; null = club's.
  bookingWindowDays  Int?
  bookingCancelHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    GroupMember[]
  coaches    GroupCoach[]
  slots      GroupScheduleSlot[]
  exceptions ScheduleException[]
  courseAudiences CourseAudience[]

  attendanceSessions AttendanceSession[]
  dropInBookings     DropInBooking[]
  classOccurrences   ClassOccurrence[]

  @@index([workspaceId])
  @@index([gymId])
  @@index([coachId])
  @@index([directionId])
}

// Junction for additional ("assistant") coaches plus a denormalised
// row for the primary coach so a single query covers all coaches of a
// group. role='primary' must always exist exactly once and mirrors
// Group.coachId — kept in sync by the create/update-group handlers.
model GroupCoach {
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation("GroupCoaches", fields: [userId], references: [id], onDelete: Cascade)

  role String @db.VarChar(16) // "primary" | "assistant"

  createdAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// Recurring weekly training. A group has 0..N slots (Tue 19:00, Thu 19:00,
// etc.). Times are wall-clock in the workspace's timezone — projection to
// concrete dates happens at read time so DST changes don't drift stored
// values. effectiveFrom/Until let a slot be added "starting Sept 1" or
// retired without deleting the row (audit-friendly).
model GroupScheduleSlot {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // ISO 8601 day of week: 1=Mon..7=Sun.
  dayOfWeek   Int
  // Wall-clock 24h time, e.g. "19:00".
  startTime   String @db.VarChar(5)
  durationMin Int

  // Optional date bounds. NULL = no bound on that side.
  effectiveFrom  DateTime? @db.Date
  effectiveUntil DateTime? @db.Date

  // Spots per class of this slot in a BOOKING group; null = the group's.
  capacity Int?

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  exceptions ScheduleException[]

  attendanceSessions AttendanceSession[]
  dropInBookings     DropInBooking[]
  classOccurrences   ClassOccurrence[]

  @@index([groupId, dayOfWeek])
  // Reminder job: slots starting at a given weekday + wall-clock minute.
  @@index([dayOfWeek, startTime])
}

enum GroupBookingMode {
  FIXED
  BOOKING
}

// One dated class of a BOOKING group that somebody booked (or whose capacity
// was overridden). Created lazily by the first booking; the row is the lock
// every booking write of the class takes (SELECT … FOR UPDATE), so capacity
// and waitlist promotion are serialized per class across replicas.
// startAt/endAt are refreshed on every booking write (sweeps read them).
model ClassOccurrence {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  groupId String            @db.Uuid
  group   Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slotId  String            @db.Uuid
  slot    GroupScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  // Slot-local calendar date, like DropInBooking.sessionDate.
  sessionDate DateTime @db.Date
  // scheduledOccurrenceKey(slotId, sessionDate) = AttendanceSession.occurrenceKey.
  occurrenceKey String @db.VarChar(128)

  // Spots for this date only; null = slot's, else group's capacity.
  capacity Int?

  startAt DateTime
  endAt   DateTime
  // When the after-class sweep closed it (no-shows, attended, expired waitlist).
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings ClassBooking[]

  @@unique([workspaceId, occurrenceKey])
  @@index([settledAt, endAt])
  @@index([startAt])
  @@index([groupId, sessionDate])
}

enum ClassBookingStatus {
  BOOKED            // holds a spot
  WAITLISTED        // in the queue, promoted automatically when a spot frees
  ATTENDED          // marked present
  CANCELLED         // cancelled in time (or a waitlist place given up)
  LATE_CANCELLED    // cancelled after the deadline
  NO_SHOW           // booked, not marked present
  CANCELLED_BY_CLUB // the class was cancelled
  EXPIRED           // still on the waitlist when the class started
}

// A member's place in one class of a BOOKING group. Rows are history: a
// cancelled booking stays, a re-booking is a new row. At most one live
// (BOOKED / WAITLISTED) row per member and class — enforced under the
// occurrence lock. Keyed on User (rosters key on User).
model ClassBooking {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  occurrenceId String          @db.Uuid
  occurrence   ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation("ClassBookings", fields: [userId], references: [id], onDelete: Cascade)

  status ClassBookingStatus

  // Who wrote it: the member, their guardian (act-as) or staff. Not a relation:
  // display only, survives the actor's removal.
  bookedById   String?  @db.Uuid
  // Staff added it while the class was full.
  overCapacity Boolean  @default(false)
  // Moved from the waitlist to a spot.
  promotedAt   DateTime?
  cancelledAt  DateTime?

  // A late cancel / no-show that burned a class: the pack it was taken from
  // (refunded if the member turns out to have been there).
  classBurned          Boolean       @default(false)
  burnedSubscriptionId String?       @db.Uuid
  burnedSubscription   Subscription? @relation("ClassBookingBurns", fields: [burnedSubscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurrenceId, status, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@index([burnedSubscriptionId])
}

// Marks specific occurrences as cancelled. Two shapes:
//   slotId IS NULL  -> the whole group is off in [fromDate, untilDate]
//                      (e.g. coach vacation, holidays).
//   slotId set      -> only that weekly slot is skipped in the range
//                      (typically a 1-day range for "this Tuesday off").
// `untilDate` is inclusive. Reason is shown to students next to the
// struck-through occurrence so they know why training isn't happening.
model ScheduleException {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  slotId String?            @db.Uuid
  slot   GroupScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)

  fromDate  DateTime @db.Date
  untilDate DateTime @db.Date
  reason    String?  @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, fromDate, untilDate])
}

// Workspace-wide one-off events: seminars, open mats, special classes.
// Visible to every workspace member regardless of group/gym so a student
// can drop into another gym's open mat. Optional gym/coach are display
// metadata, not access controls. createdById is for audit + "ваш ивент"
// labelling, not for permission checks.
model WorkspaceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(255)
  description String? @db.Text
  link        String? @db.VarChar(500)

  startAt DateTime
  endAt   DateTime
  // IANA timezone the event's wall-clock start/end were entered in. Lets
  // a Moscow workspace publish a Tomsk seminar at "14:00 Asia/Krasnoyarsk"
  // without the admin doing offset math; clients render in this zone so
  // viewers anywhere see the same wall-clock the organiser chose.
  // Default exists for db push to backfill existing rows; the create
  // handler always sets an explicit value derived from workspace.timezone
  // when the admin doesn't pick one.
  timezone String   @default("Europe/Moscow") @db.VarChar(64)

  gymId     String? @db.Uuid
  gym       Gym?    @relation(fields: [gymId], references: [id], onDelete: SetNull)

  // Discipline of the event (a БЖЖ seminar); null = club-wide. Visible to the
  // whole club either way — it tags the event for the schedule filter and
  // counts its attendance towards that direction.
  directionId String?    @db.Uuid
  direction   Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)

  // Coach-created events advertise the running coach; admin-created events
  // can leave it null. Not a permission field.
  coachId   String? @db.Uuid
  coach     User?   @relation("EventCoach", fields: [coachId], references: [id], onDelete: SetNull)

  createdById String @db.Uuid
  createdBy   User   @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceSessions AttendanceSession[]

  @@index([workspaceId, startAt])
  @@index([gymId])
  @@index([directionId])
}

// Junction: students assigned to a group. A student can be in several
// groups (morning + competition). Removing a student from the workspace
// cascades to their group memberships via the User relation.
model GroupMember {
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// Short human code members type — or open as https://app.<domain>/join/<code>
// (also the QR) — to ask to join. 8 chars from 23456789ABCDEFGHJKMNPQRSTUVWXYZ
// (no 0/O/1/I/L), stored without the display hyphen. No row until first needed:
// ensureJoinCode() creates it lazily, so existing clubs need no backfill.
// Rotatable by an admin. NOT Workspace.key: the key is a permanent public
// handle that white-label builds embed and the console says must never change.
// A separate table (not a Workspace column) because a new @unique on an
// existing table makes the production `prisma db push` refuse.
model WorkspaceJoinCode {
  workspaceId String    @id @db.Uuid
  code        String    @unique @db.VarChar(16)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// The club's public address, app.<domain>/c/<slug>. Generated from the name the
// first time an admin opens «Публичная страница» (no backfill), editable there.
// A separate table for the same reason as WorkspaceJoinCode: a new @unique on
// Workspace would make the production `prisma db push` refuse.
model WorkspacePublicSlug {
  workspaceId String    @id @db.Uuid
  slug        String    @unique @db.VarChar(64)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // РОЛЬ в workspace
  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  // СТАТУС участия
  status MemberStatus @default(ACTIVE)

  // ПОДПИСКА (если есть)
  // Purchase history and the current abonements (several may be live at once,
  // e.g. «БЖЖ 12» and «Тайский бокс 8») live on the Subscription side.
  // "Current" = ACTIVE and not past its endDate — one rule,
  // domains/subscriptions/current-subscriptions.ts.
  subscriptions  Subscription[] @relation("MemberSubscriptions")

  // Manual access window: null = без ограничения; иначе доступ есть до этой даты включительно.
  // Assigning an abonement sets this to the subscription's endDate; owner can
  // still override it manually via update-workspace-member-access.
  accessUntil DateTime?

  // Per-member opt-out from the attendance leaderboard: when true the member is
  // hidden from and unranked in the public board (they still see their own
  // stats). Gated further by Workspace.leaderboardEnabled.
  hideFromLeaderboard Boolean @default(false)

  // Private staff notes about this member (injuries, goals, payment context…).
  // Admin/coach-only — never exposed to the member's own app.
  notes String? @db.Text

  // Latest AttendanceRecord.markedAt in this club, kept by mark/unmark/self
  // check-in (features/attendance/last-attended.ts). Lets the daily inactivity
  // nudge read one indexed column instead of aggregating every attendance row.
  lastAttendedAt DateTime?

  // Per-club mute set by the member from the app. Producers skip this club's
  // non-critical notifications for them; payment, access and membership
  // notices still go (see domains/notifications/notification-mute.ts).
  notificationsMuted Boolean @default(false)

  // Last app activity in this club (WorkspaceMemberGuard touches it at most
  // hourly). With lastAttendedAt it decides who is an «active member» for the
  // platform tier (domains/billing/active-members). null = never seen.
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, workspaceId]) // Пользователь только раз в workspace
  @@index([workspaceId])
  @@index([userId])
  @@index([roleId])
  @@index([workspaceId, status, lastAttendedAt])
  @@index([workspaceId, status, lastSeenAt])
}

// A club admin's offer of membership to someone who ALREADY has an account
// (invite / add / import by e-mail). Nothing changes on the person's side until
// they accept in the app: accepting creates (or reactivates) the ACTIVE
// WorkspaceMember with this role and, for a student, joins the group;
// declining deletes the row. A separate table rather than a MemberStatus value
// because MemberStatus.INVITED already means "applied, awaiting approval" and
// the member row must stay untouched (a turned-down request keeps its status).
// Brand-new accounts created by an invite skip this and are ACTIVE at once.
// roleName/groupId are plain values (no FK): a deleted group is re-checked on
// accept and simply skipped.
model WorkspaceInvitation {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleName String  @db.VarChar(100) // 'user' | 'coach'
  groupId  String? @db.Uuid

  // Audit-only: who sent it. Not a relation so deleting that admin's
  // account never blocks or erases the invitation.
  invitedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Video {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(255)
  description String? @db.Text
  url         String  @db.Text

  status       String  @default("uploading") @db.VarChar(50)
  isPublic     Boolean @default(false)
  rawBucket    String? @db.VarChar(255)
  rawKey       String? @db.VarChar(512)
  hlsBucket    String? @db.VarChar(255)
  hlsMasterKey String? @db.VarChar(512)
  errorMessage String? @db.Text

  duration     Int?
  thumbnailUrl String?
  // Size of the uploaded source in bytes, measured with an S3 HEAD when the
  // upload completes. Summed per workspace for the plan's storage limit; null
  // for uploads that never completed.
  sizeBytes BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags       VideoTag[]
  categories VideoCategory[]
  courses    CourseVideo[]
  watched    VideoWatched[]
  favorites  VideoFavorite[]
  timestamps VideoTimestamp[]
  subtitles  VideoSubtitle[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

// VTT/SRT caption track attached to a video. Files live in S3
// (storageKey + publicUrl); this row is just metadata + ordering.
// language is a BCP-47 tag the player surfaces in its track menu.
model VideoSubtitle {
  id         String   @id @default(uuid()) @db.Uuid
  videoId    String   @db.Uuid
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  language   String   @db.VarChar(16)
  label      String   @db.VarChar(64)
  storageKey String
  publicUrl  String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([videoId, language])
  @@index([videoId])
}

// Per-video chapter markers (a.k.a. timestamps). Each row pins a label to
// a position in seconds from the start of the video. Distinct from the
// course-level Chapter model which groups whole videos together.
model VideoTimestamp {
  id          String   @id @default(uuid()) @db.Uuid
  videoId     String   @db.Uuid
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  positionSec Int
  title       String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([videoId, positionSec])
}

// Per-user starred videos. Stored server-side so favorites survive
// re-installs and sync across phone + future tablet/web. workspaceId
// lets us scope listings (and one day enforce membership before
// returning a label), even though videos themselves are workspace-bound.
model VideoFavorite {
  userId      String   @db.Uuid
  videoId     String   @db.Uuid
  workspaceId String   @db.Uuid
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, videoId])
  @@index([userId, workspaceId, createdAt])
  @@index([videoId])
}

model VideoWatched {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Last known playback position in seconds.
  position  Float    @default(0)
  /// Marked done either by reaching ≥90% of duration or via "mark watched".
  completed Boolean  @default(false)
  /// Updated each time the client posts progress; used as "last activity".
  watchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([workspaceId, userId])
  @@index([videoId])
}

model TagEntity {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type String @db.VarChar(50)

  name String @db.VarChar(255)
  slug String @db.VarChar(255)

  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryTags   VideoTag[] @relation("Primary")
  secondaryTags VideoTag[] @relation("Secondary")
  contextTags   VideoTag[] @relation("Context")

  @@unique([type, slug, workspaceId])
  @@index([workspaceId, type])
}

model VideoTag {
  id String @id @default(uuid()) @db.Uuid

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  primaryId String    @db.Uuid
  primary   TagEntity @relation("Primary", fields: [primaryId], references: [id], onDelete: Restrict)

  secondaryId String?    @db.Uuid
  secondary   TagEntity? @relation("Secondary", fields: [secondaryId], references: [id], onDelete: SetNull)

  contextId String?    @db.Uuid
  context   TagEntity? @relation("Context", fields: [contextId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([videoId, primaryId, secondaryId, contextId])
  @@index([primaryId])
  @@index([primaryId, secondaryId])
  @@index([primaryId, contextId])
}

model Category {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String @db.VarChar(255)
  slug String @db.VarChar(255)

  parentId String?    @db.Uuid
  parent   Category?  @relation("Tree", fields: [parentId], references: [id])
  children Category[] @relation("Tree")

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos VideoCategory[]

  @@unique([slug, workspaceId, parentId])
  @@index([workspaceId])
}

model VideoCategory {
  videoId    String   @db.Uuid
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  order Int @default(0)

  @@id([videoId, categoryId])
}

model Course {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title String @db.VarChar(255)
  slug  String @db.VarChar(255)

  description  String? @db.Text
  thumbnailUrl String?

  status            String?  @db.VarChar(50)
  // Free-text difficulty label shown next to the title («Начальный»). Display
  // only — who may watch is CourseAudience, not this.
  level             String?  @db.VarChar(50)
  // Lessons open one by one: a lesson unlocks once the previous required
  // (non-optional) lesson is completed (VideoWatched.completed, set at ≥ 90%).
  // Enforced server-side in get-playlist and on playback/offline/progress.
  lockedProgression Boolean  @default(false)
  // Hidden draft courses don't show up in student-facing list/get queries
  // (staff still see them in the admin). Default true so existing rows
  // stay visible — admins flip to false when preparing a course.
  isPublic          Boolean  @default(true)
  // Optional scheduled publish moment. When set and in the future,
  // students still see the course hidden until that instant — even if
  // isPublic=true. Checked at read time, no cron required: student
  // queries gate on (isPublic AND (publishedAt IS NULL OR publishedAt <= NOW())).
  publishedAt       DateTime?
  tags              String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos   CourseVideo[]
  chapters Chapter[]
  audience CourseAudience[]

  @@unique([slug, workspaceId])
}

enum CourseAudienceKind {
  GROUP
  RANK
  PLAN
  DIRECTION
}

// Who among the club's students may watch a course. No rows = everyone. Rows
// of one kind are OR-ed (any of the groups / any of the plans / the minimum
// level on any ladder); different kinds are AND-ed. Staff always see all.
// A course restricted by GROUP is hidden from everyone else; RANK and PLAN
// courses show as locked teasers with the reason. See course-audience.ts.
// `kind` is stored separately from the nullable target so deleting a group,
// level or plan (SetNull) leaves a row that matches nobody: the course stays
// closed instead of silently opening to the whole club.
model CourseAudience {
  id       String             @id @default(uuid()) @db.Uuid
  courseId String             @db.Uuid
  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind     CourseAudienceKind

  groupId String? @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Minimum level on its ladder: members whose current level on that ladder
  // has order >= this level's order qualify.
  rankLevelId String?    @db.Uuid
  rankLevel   RankLevel? @relation(fields: [rankLevelId], references: [id], onDelete: SetNull)

  // A usable (isSubscriptionUsable) abonement on this tariff qualifies.
  planId String? @db.Uuid
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Members of any group of this direction qualify (hidden otherwise, like GROUP).
  directionId String?    @db.Uuid
  direction   Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([groupId])
  @@index([rankLevelId])
  @@index([planId])
  @@index([directionId])
}

// First-class section grouping inside a course. Lessons reference a
// chapter via CourseVideo.chapterId; chapters carry their own ordering so
// empty sections persist and renaming/reordering doesn't depend on which
// videos happen to live there.
model Chapter {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String @db.VarChar(255)
  // Ordinal position of the chapter within the course. Renumbered as a
  // batch on reorder so transient duplicates don't fight a UNIQUE.
  order Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos CourseVideo[]

  @@index([courseId, order])
}

model CourseVideo {
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // Ordinal position within the course. Not unique — reorder renumbers all
  // rows of the course in a single transaction, so dirty intermediate states
  // would otherwise collide with a UNIQUE.
  order       Int      @default(0)
  lessonTitle String?  @db.VarChar(255)
  // Section the lesson belongs to. SetNull keeps the lesson when its
  // chapter is deleted — it just falls back into "ungrouped" until the
  // user reassigns it.
  chapterId   String?  @db.Uuid
  chapter     Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  stepType    String?  @db.VarChar(50)
  isOptional  Boolean  @default(false)

  @@id([courseId, videoId])
  @@index([courseId, order])
  @@index([chapterId])
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @db.VarChar(128)
  isRevoked Boolean  @default(false)
  expiresAt DateTime

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // Every token minted by rotating one sign-in shares the sign-in's family.
  // Presenting an already-rotated token revokes the whole family (reuse
  // detection). Null only on rows from before families existed.
  familyId String? @db.Uuid

  @@index([userId])
  // Nightly purge of expired tokens.
  @@index([expiresAt])
  @@index([familyId])
}

// Wrong-code counter per (account, client address). Lets sign-in lock out the
// address that keeps guessing without locking the account's owner out from
// their own device; User.signInFailedAttempts is the account-wide ceiling.
// The address is stored as a SHA-256 hash, never in the clear.
model SignInThrottle {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash String @db.VarChar(64)

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, ipHash])
}

// A sign-in code request by e-mail that is not yet proven. An unknown address
// gets no User row until the emailed code is entered (sign-in creates it), so
// the code, its cooldown and the account-wide wrong-code ceiling live here,
// keyed by the normalised address. For an existing account the code stays on
// User and a row here only carries the club join request (joinWorkspaceKey)
// asked for with the code; it is filed once sign-in succeeds. The row is
// deleted on a successful sign-in; stale ones are purged nightly.
model PendingSignIn {
  email String @id

  // bcrypt hash of the emailed code; null for an existing account's row.
  codeHash         String?
  codeIssuedAt     DateTime?
  codeNextResendAt DateTime?
  language         LanguageEnum?

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  joinWorkspaceKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  throttles PendingSignInThrottle[]

  @@index([updatedAt])
}

// SignInThrottle for an address that has no account yet.
model PendingSignInThrottle {
  email   String
  pending PendingSignIn @relation(fields: [email], references: [email], onDelete: Cascade)
  ipHash  String        @db.VarChar(64)

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([email, ipHash])
}

// ═══════════════════════════════════════════════════════════════
// ROLE & PERMISSIONS 
// ═══════════════════════════════════════════════════════════════

model Role {
  id String @id @default(uuid()) @db.Uuid

  name      String  @unique @db.VarChar(100)
  superuser Boolean @default(false)
  editable  Boolean @default(true)

  members     WorkspaceMember[]
  permissions RolePermission[]
}

model RolePermission {
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid

  feature   RoleFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String      @db.Uuid

  allowed Boolean @default(false)

  @@id([roleId, featureId])
  @@index([roleId])
  @@index([featureId])
}

model RoleFeature {
  id String @id @default(uuid()) @db.Uuid

  key         String   @unique @db.VarChar(100) // "videos.create", "users.manage"
  description String?  @db.Text
  group       String?  @db.VarChar(50) // "videos", "users", "workspace"
  alwaysIn    Boolean?

  permissions RolePermission[]
}

model TfaRequestGroup {
  id             String          @id @default(uuid()) @db.Uuid
  alwaysEnabled  Boolean         @default(false)
  key            String          @unique
  description    String?
  tfaPermissions TfaPermission[]
}

model TfaPermission {
  group    TfaRequestGroup @relation(fields: [groupId], references: [id])
  groupId  String          @db.Uuid
  method   TfaMethod       @relation(fields: [methodId], references: [id])
  methodId String          @db.Uuid
  enabled  Boolean         @default(false)

  @@id([groupId, methodId])
}

model TfaMethod {
  id      String            @id @default(uuid()) @db.Uuid
  type    TfaMethodTypeEnum
  enabled Boolean           @default(false)
  secret  String

  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id])
  tfaPermissions TfaPermission[]
}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// SUBSCRIPTION
// ═══════════════════════════════════════════════════════════════

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  planId String @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(ACTIVE)
  // null = waits for the first visit (startsOnFirstVisit). First-visit starts are
  // the club-local (workspace tz) midnight of that visit's day.
  startDate DateTime?
  endDate   DateTime?
  // Copied from the plan at sale, so a later tariff edit can't change what was bought.
  startsOnFirstVisit Boolean @default(false)
  // Plan.durationDays at sale; null on rows created before this column existed.
  durationDays       Int?

  // Agreed price while isPaid=false; the amount received once paid. Revenue counts
  // isPaid rows only — always go through revenue.ts paidInRangeWhere().
  amountPaid Int
  currency   String @db.Char(3)
  // false = sold, not paid yet («Ожидает оплаты»). Default true: rows from before
  // payment tracking, and sales recorded as paid, read as paid.
  isPaid     Boolean   @default(true)
  // When the payment was recorded; null while unpaid and on legacy rows (their
  // revenue date falls back to createdAt).
  paidAt     DateTime?

  // Class-pack balance (null for time-only tariffs). classesTotal is what the
  // tariff granted; classesRemaining is decremented on attendance check-in
  // (refunded on un-mark). Independent of accessUntil — hitting 0 never revokes
  // app access; unused classes simply lapse when the window (endDate) passes.
  classesTotal     Int?
  classesRemaining Int?

  // Attendance check-ins that deducted a class from this pack (back-ref for the
  // refund-on-unmark link above).
  consumedRecords AttendanceRecord[] @relation("ConsumedClasses")
  // Check-ins attributed to this abonement (deducted or not).
  usedRecords     AttendanceRecord[] @relation("UsedSubscription")
  // Late cancels / no-shows of class bookings that burned a class from this pack.
  burnedBookings  ClassBooking[]     @relation("ClassBookingBurns")

  // Directions this abonement may be spent on, copied from the tariff at sale
  // (a later tariff edit never changes what was bought). Empty = club-wide.
  directions SubscriptionDirection[]

  // Buyer/owner of this purchase — gives a member their subscription history.
  workspaceMemberId String?          @db.Uuid
  workspaceMember   WorkspaceMember? @relation("MemberSubscriptions", fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  // How the purchase was recorded and the provider's references: MANUAL for a
  // sale in the admin; an online payment's webhook sets GATEWAY plus
  // provider/externalPaymentId (and links the Payment row below).
  source            SubscriptionSource @default(MANUAL)
  provider          String?            @db.VarChar(64)
  externalPaymentId String?            @db.VarChar(255)
  payment           Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freezes SubscriptionFreeze[]
  freezeRequests SubscriptionFreezeRequest[]

  @@index([workspaceId])
  @@index([status])
  @@index([endDate])
  @@index([workspaceMemberId])
  @@index([workspaceId, isPaid])
  // Sweeps: payment reminders (status, isPaid, startDate), first-visit
  // pending (status, startsOnFirstVisit, startDate), per-club unpaid lists.
  @@index([status, isPaid, startDate])
  @@index([status, startsOnFirstVisit, startDate])
  @@index([workspaceId, status, isPaid, startDate])
}

// A pause of an abonement's clock ("заморозка"), e.g. while a member is injured.
// Club-local calendar days, both ends inclusive. Creating one moves
// Subscription.endDate (and accessUntil, see accessShifted) forward by its length
// in the same transaction, so every date-driven reader (isSubscriptionUsable,
// expiry reminders, the apps) keeps working unchanged. "Frozen now" is derived
// (fromDate <= today <= untilDate) — nothing flips Subscription.status.
// Ending early shrinks untilDate to yesterday, or deletes a freeze that hasn't
// started, and gives the unused days back.
model SubscriptionFreeze {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // The member (rosters key on User; the owner never has an abonement).
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromDate  DateTime @db.Date
  untilDate DateTime @db.Date

  // Shown to the member ("Травма", "Отпуск", …). Free text, not an enum —
  // reasons differ per club and discipline.
  reason String? @db.VarChar(200)

  // Whether creating this freeze also moved WorkspaceMember.accessUntil (it does
  // when accessUntil tracked the abonement, i.e. >= its endDate). Ending early
  // gives days back to accessUntil only when true. Cleared when an admin sets the
  // access window by hand — an explicit date is final.
  accessShifted Boolean @default(false)

  // Set when an admin ended it before the planned last day (untilDate was then
  // moved to the day before).
  endedEarlyAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, untilDate])
  @@index([workspaceId, userId, fromDate])
}

model Plan {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(255)
  description String? @db.Text
  price       Int
  currency    String  @db.Char(3)

  // Access length granted when this tariff is assigned: a subscription's
  // endDate = startDate + durationDays, which drives app access (accessUntil).
  // For class-packs this is the validity window (30 = one month) after which
  // unused classes are gone and the member buys a new abonement.
  durationDays Int     @default(30)

  // Class-pack size: how many attendances this tariff grants. null = time-only
  // (no per-class limit within the window). The member's remaining balance
  // lives on the Subscription and is decremented on check-in — independent of
  // accessUntil, so running out of classes never revokes app access.
  classCount Int?
  // A once-per-member free tariff (e.g. the first class free). Assigning it to
  // the same member twice is refused.
  isFreeTrial Boolean @default(false)
  // «Срок считается с первой тренировки»: an abonement sold on this tariff waits
  // for the member's first visit on/after the sale day; startDate/endDate stay
  // null until then. Off by default — other clubs keep "starts on the sale day".
  startsOnFirstVisit Boolean @default(false)

  // Retire a tariff from the pick-list without deleting the historical
  // subscriptions that reference it.
  isActive     Boolean @default(true)

  // Members can buy this tariff in the app («Оплатить онлайн») once the club
  // has connected a payment provider (WorkspacePaymentSettings). Off by default:
  // the club picks which tariffs are sold online.
  purchasableOnline Boolean @default(false)

  // Directions whose visits may draw this tariff («БЖЖ + ММА 12 занятий»).
  // Empty = club-wide (every direction and classes without a direction).
  directions PlanDirection[]

  subscriptions Subscription[]
  courseAudiences CourseAudience[]
  payments      Payment[]

  @@index([workspaceId])
}

// One direction of a tariff's scope (see Plan.directions).
model PlanDirection {
  planId      String    @db.Uuid
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  directionId String    @db.Uuid
  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@id([planId, directionId])
  @@index([directionId])
}

// One direction of a sold abonement's scope, snapshotted from the tariff at sale.
model SubscriptionDirection {
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  directionId    String       @db.Uuid
  direction      Direction    @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, directionId])
  @@index([directionId])
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String? @db.Uuid
  actorId     String? @db.Uuid
  actorEmail  String?

  action     String  @db.VarChar(64)
  targetType String  @db.VarChar(64)
  targetId   String? @db.VarChar(128)
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@index([action])
}

// A concrete class/event occurrence a coach took attendance for. Created
// lazily on first "take attendance" for that occurrence. Wraps a scheduled
// slot (slotId+sessionDate), an ad-hoc coach session, or a one-off event
// (workspaceEventId). title/startAt/timezone are denormalized at creation so
// history renders even after the source slot/group/event is deleted.
model AttendanceSession {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  groupId String? @db.Uuid
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  slotId  String? @db.Uuid
  slot    GroupScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  sessionDate DateTime? @db.Date

  workspaceEventId String? @db.Uuid
  workspaceEvent   WorkspaceEvent? @relation(fields: [workspaceEventId], references: [id], onDelete: SetNull)

  // Single dedupe key across all three kinds, formatted only in
  // attendance-utils.ts: "slot:<slotId>:<yyyy-mm-dd>" |
  // "adhoc:<groupId>:<yyyy-mm-ddThh:mm>" | "event:<workspaceEventId>" |
  // "personal:<requestId>".
  occurrenceKey String @db.VarChar(128)

  title    String   @db.VarChar(255)
  startAt  DateTime
  timezone String   @db.VarChar(64)

  // Short code the coach shows the class so members can self-check-in. Shown
  // only in the coach-facing roster, never in member session views.
  checkInCode String? @db.VarChar(12)

  // 1:1 personal training with the session's coach. No group, no check-in code
  // (the coach marks the one member); never deducts a group class pack.
  isPersonal Boolean @default(false)

  coachId     String? @db.Uuid
  coach       User?   @relation("SessionCoach", fields: [coachId], references: [id], onDelete: SetNull)
  createdById String  @db.Uuid
  createdBy   User    @relation("SessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  notes   String? @db.Text
  records AttendanceRecord[]
  personalTraining PersonalTrainingRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, occurrenceKey])
  @@index([workspaceId, startAt])
  @@index([groupId, startAt])
}

// One present-mark. Keyed on User (not WorkspaceMember): matches
// GroupMember/Group.coachId, lets the owner be marked, and survives a member
// being removed from the workspace. workspaceId denormalized so /me and
// workspace-scoped counts are a single indexable scan. isGuest is a
// point-in-time capture (null for event sessions with no group).
model AttendanceRecord {
  id        String            @id @default(uuid()) @db.Uuid
  sessionId String            @db.Uuid
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation("WorkspaceAttendanceRecords", fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)

  isGuest Boolean?

  markedById String   @db.Uuid
  markedBy   User     @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  markedAt   DateTime @default(now())

  // The class-pack subscription this check-in actually deducted a class from,
  // if any. Set only when a class was really consumed (member had a class-pack
  // with balance > 0). Un-marking refunds THIS exact subscription — so training
  // past an exhausted pack (no deduction) or a later pack change can't mint a
  // free class on un-mark. SetNull: a deleted subscription just clears the tag.
  consumedSubscriptionId String?       @db.Uuid
  consumedSubscription   Subscription? @relation("ConsumedClasses", fields: [consumedSubscriptionId], references: [id], onDelete: SetNull)

  // The abonement this visit was attributed to (visit precedence,
  // domains/subscriptions/visit-abonement.ts) — a class pack it drew from or a
  // time-based one that only counted it. Null = no matching abonement. Drives
  // «списано с …» in the roster and the start of a «с первой тренировки» one.
  usedSubscriptionId String?       @db.Uuid
  usedSubscription   Subscription? @relation("UsedSubscription", fields: [usedSubscriptionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([workspaceId, userId, markedAt])
  // Workspace-wide time windows (retention engine, dashboard counts) without
  // walking every member's slice of [workspaceId, userId, markedAt].
  @@index([workspaceId, markedAt])
  @@index([sessionId])
  @@index([usedSubscriptionId])
}

// A member's RSVP to another group's scheduled class («Приду на тренировку»).
// Keyed to the occurrence (slot + slot-local date), not to an AttendanceSession:
// sessions are created lazily when a coach opens the roster, and one per booking
// would inflate «занятий проведено» and outlive a later cancellation. Nothing is
// charged here — a class is deducted only when the member is marked present
// (mark-records / self-check-in). Cancelling deletes the row. Keyed on User.
model DropInBooking {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String            @db.Uuid
  group   Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slotId  String            @db.Uuid
  slot    GroupScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  // Slot-local calendar date — the same yyyy-mm-dd create-session receives.
  sessionDate DateTime @db.Date
  // scheduledOccurrenceKey(slotId, sessionDate): equals AttendanceSession.occurrenceKey
  // once the coach opens the roster — that is how the roster finds bookings.
  occurrenceKey String @db.VarChar(128)

  createdAt DateTime @default(now())

  @@unique([workspaceId, occurrenceKey, userId])
  @@index([workspaceId, userId, sessionDate])
  @@index([workspaceId, sessionDate])
}

enum PersonalTrainingStatus {
  PENDING_COACH   // «Ожидает тренера»
  PENDING_MEMBER  // «Тренер предложил другое время»
  CONFIRMED       // «Подтверждена» («Прошла» is derived from the time)
  DECLINED        // «Отклонена»
  CANCELLED       // «Отменена»
}

// A coach who takes personal sessions in this workspace. Row = opted in
// («Провожу персональные тренировки»); deleting it opts out. Keyed on User so an
// owner who coaches (no WorkspaceMember row) can opt in.
model PersonalTrainingCoach {
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([workspaceId, userId])
}

// Member ↔ coach negotiation for one personal session. Price is off-app.
model PersonalTrainingRequest {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  memberId String @db.Uuid
  member   User   @relation("PersonalTrainingMember", fields: [memberId], references: [id], onDelete: Cascade)
  coachId  String @db.Uuid
  coach    User   @relation("PersonalTrainingCoach", fields: [coachId], references: [id], onDelete: Cascade)

  // Optional: a club may run personal sessions at one gym or anywhere.
  gymId String? @db.Uuid
  gym   Gym?    @relation(fields: [gymId], references: [id], onDelete: SetNull)
  // Zone the wall-clock options were entered in (gym tz ?? workspace tz), fixed at request.
  timezone String @db.VarChar(64)

  status PersonalTrainingStatus @default(PENDING_COACH)

  memberComment String? @db.VarChar(500) // with the request
  coachComment  String? @db.VarChar(500) // with the latest coach proposal
  closeComment  String? @db.VarChar(500) // decline / cancel reason
  closedByRole  String? @db.VarChar(8)   // 'member' | 'coach' (admin acting = 'coach')

  confirmedStartAt     DateTime?
  confirmedDurationMin Int?
  sessionId String?            @unique @db.Uuid
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  options PersonalTrainingOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, memberId, updatedAt])
  @@index([workspaceId, coachId, updatedAt])
  @@index([workspaceId, updatedAt])
}

model PersonalTrainingOption {
  id          String                  @id @default(uuid()) @db.Uuid
  requestId   String                  @db.Uuid
  request     PersonalTrainingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startAt     DateTime
  durationMin Int
  proposedBy  String                  @db.VarChar(8) // 'member' | 'coach'
  createdAt   DateTime                @default(now())

  @@index([requestId])
}

// Config-driven progression. A workspace defines 0..N rank ladders (e.g. an
// "Adults" belt ladder and a "Kids" ladder); disciplines without ranks simply
// define none. Nothing about belts is hardcoded — a ladder is an ordered list
// of named levels, so BJJ/judo/karate/fitness-levels all fit the same shape.
model RankLadder {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String  @db.VarChar(255) // "Взрослые", "Дети", "Kyu/Dan"
  audience String? @db.VarChar(64)  // free label: "adult" | "kids" | …
  isActive Boolean @default(true)
  order    Int     @default(0)

  // Discipline the ladder belongs to (БЖЖ belts vs. тайский бокс — свои ступени).
  directionId String?    @db.Uuid
  direction   Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)

  levels     RankLevel[]
  promotions RankPromotion[]
  gradings   RankGrading[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([directionId])
}

// One rung of a ladder. `order` gives the progression sequence; `maxStripes`
// is how many degrees/stripes a member can hold at this level before the next.
model RankLevel {
  id       String     @id @default(uuid()) @db.Uuid
  ladderId String     @db.Uuid
  ladder   RankLadder @relation(fields: [ladderId], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(255) // "Синий пояс", "Yellow"
  order        Int
  color        String? @db.VarChar(32)  // hex or css name for the UI
  maxStripes   Int     @default(0)
  requirements String? @db.Text

  // «Допуск к аттестации» for being promoted TO this level: at least minVisits
  // attendances and minWeeks full weeks since the member reached their current
  // level on this ladder (stripe promotions don't reset it). null = no
  // requirement on that axis; both null = no rule. Config per club, any sport.
  minVisits Int?
  minWeeks  Int?

  isActive Boolean @default(true)

  promotions        RankPromotion[]
  gradingCandidates RankGradingCandidate[]
  courseAudiences   CourseAudience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ladderId, order])
  @@index([ladderId])
}

// Immutable promotion event. A member's CURRENT rank on a ladder is the most
// recent promotion for (workspace, user, ladder). Keyed on User (matches the
// rest of the domain; the owner has no WorkspaceMember row but can hold a rank).
model RankPromotion {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation("MemberRankPromotions", fields: [userId], references: [id], onDelete: Cascade)

  ladderId String     @db.Uuid
  ladder   RankLadder @relation(fields: [ladderId], references: [id], onDelete: Cascade)

  // Restrict: a level that members have been promoted to can't be hard-deleted
  // (the handler blocks it and offers archiving via isActive).
  levelId String    @db.Uuid
  level   RankLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)

  stripes Int     @default(0)
  note    String? @db.VarChar(500)

  awardedById String @db.Uuid
  awardedBy   User   @relation("RankPromotionAwardedBy", fields: [awardedById], references: [id], onDelete: Restrict)

  awardedAt DateTime @default(now())

  gradingCandidate RankGradingCandidate?

  @@index([workspaceId, userId, ladderId, awardedAt])
  @@index([levelId])
}

enum RankGradingResult {
  PENDING
  PASSED
  FAILED
}

// A grading session («аттестация») on one rank ladder: a dated exam whose
// candidates are promoted when they pass. Its own small model, not a
// WorkspaceEvent: events broadcast a reminder to every member and any coach may
// delete them; a grading carries candidates, results and fees.
model RankGrading {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ladderId String     @db.Uuid
  ladder   RankLadder @relation(fields: [ladderId], references: [id], onDelete: Cascade)

  // Club-local calendar day (UTC midnight), like SubscriptionFreeze dates.
  date  DateTime @db.Date
  title String   @db.VarChar(255)

  gymId String? @db.Uuid
  gym   Gym?    @relation(fields: [gymId], references: [id], onDelete: SetNull)

  // Optional per-candidate fee, same integer unit as Plan.price.
  feeAmount   Int?
  feeCurrency String? @db.Char(3)

  createdById String @db.Uuid
  createdBy   User   @relation("RankGradingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  candidates RankGradingCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, date])
  @@index([ladderId])
}

model RankGradingCandidate {
  id        String      @id @default(uuid()) @db.Uuid
  gradingId String      @db.Uuid
  grading   RankGrading @relation(fields: [gradingId], references: [id], onDelete: Cascade)

  // Denormalized for the member's "my next grading" read.
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation("RankGradingCandidates", fields: [userId], references: [id], onDelete: Cascade)

  // Level (+ stripes) examined for. Restrict like RankPromotion.level; the
  // delete-level / delete-ladder handlers refuse first.
  levelId String    @db.Uuid
  level   RankLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  stripes Int       @default(0)

  // Snapshot of where the candidate stood when added ("Белый · 2 → Синий").
  fromLevelName String? @db.VarChar(255)
  fromStripes   Int?

  result   RankGradingResult @default(PENDING)
  resultAt DateTime?
  // The promotion a PASSED result created; unique = one promotion per candidate.
  promotionId String?        @unique @db.Uuid
  promotion   RankPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  // Fee bookkeeping, manual today: null = not paid. paymentRef is reserved for a
  // future online payment id (cf. Subscription.externalPaymentId).
  paidAt     DateTime?
  paymentRef String?   @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradingId, userId])
  @@index([workspaceId, userId])
  @@index([levelId])
}

// Club feed / bulletin. A workspace-wide post members see in their app.
// publishedAt = null means a draft (staff-only); set it to publish. `pinned`
// floats important posts (closures, gradings) to the top.
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  title  String  @db.VarChar(255)
  body   String  @db.Text
  pinned Boolean @default(false)

  // Who sees it: everyone, or only members due for renewal (access expiring /
  // last class). Filtered per-member in the feed and in the push fan-out.
  audience AnnouncementAudience @default(ALL)

  // Only members of this direction (and the staff) see it and get the push;
  // AND-ed with `audience`. null = the whole club.
  directionId String?    @db.Uuid
  direction   Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)

  // Null = draft (not shown in the member feed).
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, publishedAt])
  @@index([directionId])
}

enum AnnouncementAudience {
  ALL
  EXPIRING
}

// A member's private training journal — their own notes after a session
// ("worked on the triangle, need to fix my hip"). Visible only to the member
// (distinct from WorkspaceMember.notes, which are staff-only). Sport-agnostic.
model TrainingJournalEntry {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The training day this entry is about (defaults to the day it was written).
  entryDate DateTime @db.Date
  body      String   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, userId, entryDate])
}

// What an achievement is measured against. Sport-agnostic — a count of
// attendances or a run of consecutive weeks.
enum AchievementMetric {
  CHECKINS
  STREAK
}

// A club-configurable achievement (badge). Members unlock it when their metric
// reaches `threshold`; unlock state is computed from attendance, not stored.
// When a workspace has none, the app falls back to a built-in default set.
model Achievement {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String            @db.VarChar(120)
  description String?           @db.VarChar(500)
  icon        String?           @db.VarChar(16) // emoji
  metric      AchievementMetric @default(CHECKINS)
  threshold   Int
  isActive    Boolean           @default(true)
  order       Int               @default(0)

  // Counts only attendance in sessions of this direction's groups/events.
  // null = club-wide (every visit counts).
  directionId String?    @db.Uuid
  direction   Direction? @relation(fields: [directionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([directionId])
}

// A staff member's mark that they reached out to an at-risk member («Связались»).
// Append-only. The newest row younger than 14 days hides the member from the
// «Кто пропадает» lists while their risk signals are a subset of `signals`
// (the snapshot taken when the contact was logged). reason/signals are
// RiskReason strings (domains/retention/risk-signals.ts), not a DB enum, so a
// new signal needs no schema change. Keyed on User like every roster.
model MemberRetentionContact {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation("RetentionContactMember", fields: [userId], references: [id], onDelete: Cascade)

  contactedById String @db.Uuid
  contactedBy   User   @relation("RetentionContactBy", fields: [contactedById], references: [id], onDelete: Restrict)

  reason  String?  @db.VarChar(32)
  signals String[] @default([])
  note    String?  @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// «Аналитика» (docs/design/2026-11-01-smart-analytics.md): precomputed
// snapshots the analytics screens read, so no request scans the attendance
// history. domains/analytics/analytics-snapshot.service.ts rebuilds them per
// club (scheduler-analytics queue: member scores hourly, visit history and slot
// occurrences nightly) and after a demo reset. Rows are replaced wholesale per
// club, never edited; group/user ids are plain values (no FK) so a deleted
// group only drops out at the next rebuild. Dates are bucketed in the club's
// timezone at compute time.
model AnalyticsRun {
  workspaceId String    @id @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Nightly part: AnalyticsMemberGroupStat + AnalyticsSlotOccurrence.
  historyComputedAt DateTime?
  // Hourly part: AnalyticsMemberSnapshot (churn score, forecast pieces).
  riskComputedAt    DateTime?
  // Share of abonements that ended in the last 180 days and were renewed
  // (null = fewer than 10 ended, the default probability is used).
  clubRenewalRate   Float?
  renewalSample     Int       @default(0)

  updatedAt DateTime @updatedAt
}

// One active student of the club: churn score with its reasons, the money at
// stake and the pieces the forecast and coach screens sum over a scope.
model AnalyticsMemberSnapshot {
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid

  // 0-100 (domains/analytics/churn-score.ts) and [{code, points, text}].
  score   Int
  reasons Json @default("[]")
  // Average monthly spend over the last 180 days, in the abonement's unit.
  monthlySpend Int     @default(0)
  currency     String? @db.Char(3)
  // Current GroupMember groups: the scope filter (gym/direction/coach).
  groupIds     String[] @default([])

  firstVisitAt DateTime?
  lastVisitAt  DateTime?

  // Forecast: renewals due inside 30/90 days if everyone renewed (potential)
  // and weighted by renewalProbability (expected).
  renewalProbability Float @default(0)
  potential30        Int   @default(0)
  expected30         Int   @default(0)
  potential90        Int   @default(0)
  expected90         Int   @default(0)
  // Abonements that ended in the last 180 days / of them renewed.
  renewalsDue  Int @default(0)
  renewalsDone Int @default(0)
  // Trial → paid conversion.
  trialStartedAt   DateTime?
  trialConvertedAt DateTime?

  computedAt DateTime

  @@id([workspaceId, userId])
  @@index([workspaceId, score])
}

// Visits of one member in one group (groupId null = events, personal and
// group-less sessions): cohort retention and coach retention aggregate these
// over the groups a filter or a staff scope allows.
model AnalyticsMemberGroupStat {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  groupId     String?   @db.Uuid

  firstVisitAt DateTime
  lastVisitAt  DateTime
  visits       Int

  @@index([workspaceId])
}

// One past scheduled class (weekly slot × club-local date, cancelled ones
// skipped) over the last 26 weeks: who came against the roster/capacity.
model AnalyticsSlotOccurrence {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groupId     String    @db.Uuid
  slotId      String    @db.Uuid
  gymId       String?   @db.Uuid

  sessionDate DateTime @db.Date
  dayOfWeek   Int
  startTime   String   @db.VarChar(5)
  // A coach opened the roster (an AttendanceSession exists).
  held        Boolean
  attended    Int
  // Group members at compute time; capacity = explicit limit when the club
  // has one, else the roster.
  roster      Int
  capacity    Int?
  // Drop-in bookings for this class / of them not marked present.
  booked         Int @default(0)
  missedBookings Int @default(0)

  @@index([workspaceId, sessionDate])
}

enum SubscriptionFreezeRequestStatus {
  PENDING   // waiting for a coach
  APPROVED  // the freeze was created through SubscriptionFreezeService
  DECLINED  // decisionComment is shown to the member
  CANCELLED // withdrawn by the member
}

// A member's ask to freeze their CURRENT abonement. Approval creates a
// SubscriptionFreeze through SubscriptionFreezeService (its rules apply then).
model SubscriptionFreezeRequest {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // The member (rosters key on User).
  userId String @db.Uuid
  user   User   @relation("FreezeRequestMember", fields: [userId], references: [id], onDelete: Cascade)

  // = subscriptionId while PENDING, null once closed: a race-safe "one pending
  // request per abonement" (Postgres allows many NULLs; Prisma has no partial unique).
  pendingSubscriptionId String? @unique @db.Uuid

  status SubscriptionFreezeRequestStatus @default(PENDING)

  // Club-local first day, same encoding as SubscriptionFreeze.fromDate.
  fromDate DateTime @db.Date
  days     Int
  reason   String   @db.VarChar(200)

  decidedById     String?   @db.Uuid
  decidedBy       User?     @relation("FreezeRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt       DateTime?
  decisionComment String?   @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([userId, workspaceId])
}

// Kinds of consent a user gives as a separate act. DEPENDENT_DATA: a guardian's
// consent to processing a dependent's (a minor's) data; the record carries
// dependentId, the link's state lives on Guardianship.consentAt.
enum ConsentKind {
  PERSONAL_DATA
  DEPENDENT_DATA
}

// Every acceptance of a consent text, kept as evidence (who, which version,
// when, from where). Append-only; account deletion = withdrawal: it stamps
// withdrawnAt and drops ip/userAgent.
model ConsentRecord {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind       ConsentKind
  version    String      @db.VarChar(64)
  acceptedAt DateTime    @default(now())
  ip         String?     @db.VarChar(64)
  userAgent  String?     @db.VarChar(512)

  withdrawnAt DateTime?

  // DEPENDENT_DATA only: whose data the guardian (userId) consented to. A
  // plain id: the evidence outlives the link, and the dependent's row is
  // only ever anonymised, never deleted.
  dependentId String? @db.Uuid

  @@index([userId, kind, acceptedAt])
  @@index([dependentId])
}

enum WorkspaceBillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

// One per workspace: where the club's ClubSpace subscription stands. The tier
// is not stored — it follows from the active-member count at quote time
// (domains/billing/platform-pricing.config.ts + quote-workspace-billing.ts).
// Everything a platform owner can override per club lives here, all audited.
model WorkspaceBilling {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @unique @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status WorkspaceBillingStatus @default(TRIAL)

  trialEndsAt      DateTime?
  // End of the paid period. null on ACTIVE = no scheduled charge (set by
  // «resume» until the operator records a paid period).
  currentPeriodEnd DateTime?
  // When the club went PAST_DUE; the grace period before SUSPENDED counts
  // from here.
  pastDueSince     DateTime?

  // 1 = monthly, 12 = annual prepay (PLATFORM_ANNUAL_DISCOUNT_PERCENT off).
  billingPeriodMonths Int @default(1)

  // Platform owner overrides. customMonthlyPrice replaces the tier price
  // (whole rubles); discountPercent comes off the recurring lines, until
  // discountUntil when set (pro rata by time, like freeUntil); freeUntil
  // makes the whole subscription free until that moment (promo).
  customMonthlyPrice Int?
  discountPercent    Int       @default(0)
  discountUntil      DateTime?
  freeUntil          DateTime?

  // One-time setup fee: charged with the first paid period unless waived.
  setupFeeWaived Boolean   @default(false)
  setupFeePaidAt DateTime?

  // Tier code of the last recorded payment, so the admin can say «you have
  // outgrown the tier you paid for». null until the first payment.
  paidTierCode String? @db.VarChar(32)

  // The account that started this club's self-serve trial. Unique: one trial
  // per account, enforced by the database rather than a racy pre-check.
  trialOwnerId String? @unique @db.Uuid

  // Operator notes from the platform console (invoice numbers, agreements).
  notes String? @db.Text

  // Autopay (domains/billing/services/platform-payments.service.ts). The card
  // saved by YooKassa with the club's first card payment is charged for each
  // renewal while autopayEnabled; the owner removes it, the platform toggles
  // autopayEnabled. Only the provider's token and display hints are kept.
  autopayEnabled         Boolean   @default(true)
  paymentMethodId        String?   @db.VarChar(64)
  paymentMethodTitle     String?   @db.VarChar(64)
  paymentMethodCardLast4 String?   @db.VarChar(4)
  paymentMethodSavedAt   DateTime?
  // Failed renewal charges in a row; the next retry is not before
  // autopayNextAttemptAt. Reset by any successful period payment.
  autopayFailedAttempts  Int       @default(0)
  autopayNextAttemptAt   DateTime?
  autopayLastError       String?   @db.VarChar(500)

  // «Пробный период с картой»: the owner binds a card during the trial and
  // the first period is charged from it when the trial ends. null = follow
  // PLATFORM_CARD_TRIAL_ENABLED; the console overrides it per club.
  cardTrial       Boolean?
  // E-mails the club sent to people during its trial, counted against
  // PLATFORM_TRIAL_EMAIL_LIMIT (domains/billing/trial-limits.ts).
  trialEmailsSent Int       @default(0)
  // The first paid period recorded (card payment or the console's «отметить
  // оплату»): the trial converted. Trial start is createdAt — every row
  // starts as TRIAL.
  convertedAt     DateTime?
  // When the club was last suspended. While it stays SUSPENDED, the daily
  // pass archives it PLATFORM_ARCHIVE_AFTER_DAYS later (archivedAt): hidden
  // from members and the public listing, nothing deleted. Archived = status
  // SUSPENDED and archivedAt set; a payment or the console lifts it.
  suspendedAt     DateTime?
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum PlatformModule {
  VIDEO
  ONLINE_PAYMENTS
  BRANDED_APP
}

// PAID = on the club's bill; COMP = granted free until compUntil (then off);
// OFF = switched off by the platform, even during the trial.
enum PlatformModuleMode {
  PAID
  COMP
  OFF
}

// A club's entitlement to one paid module. No row = the default: on during
// the trial, off afterwards (domains/billing/module-entitlement.ts).
model WorkspaceModuleEntitlement {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  module PlatformModule
  mode   PlatformModuleMode
  // COMP: free until this moment.
  compUntil   DateTime?
  // PAID: whole rubles per month instead of the configured module price.
  customPrice Int?
  // PAID only: the club disconnected the module; it stays on (and on the
  // bill) until this moment, then counts as not bought. The platform setting
  // a mode clears it.
  cancelAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, module])
}

// An app-section switch (`<feature>Enabled` on Workspace) the platform owner
// pinned for a club: the column is set to `enabled` and the club's admin
// cannot change it while the lock holds (until null = indefinitely, else
// through `until`). Deleting the row (unlock) hands the switch back.
model WorkspaceFeatureLock {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // An APP_FEATURE_KEYS key (domains/workspace/feature-flags.ts).
  feature String    @db.VarChar(32)
  enabled Boolean
  until   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, feature])
}

// Seconds of video watched in a club per calendar month (UTC), accumulated
// from playback progress saves (domains/billing/video-usage.ts documents the
// approximation). Feeds the VIDEO module's viewing allowance and overage.
model VideoViewingMonth {
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // First day of the month.
  month   DateTime @db.Date
  seconds Int      @default(0)

  @@id([workspaceId, month])
}

// PERIOD = a subscription period (the owner's card payment, an autopay
// renewal, or a free renewal of a club whose bill is 0); MODULE = the
// pro-rata part of a module connected mid-period; CARD_CHECK = the small
// payment that binds a card during a «пробный период с картой», refunded at
// once (never a charge for the service).
enum PlatformPaymentKind {
  PERIOD
  MODULE
  CARD_CHECK
}

enum OnboardingHelpStatus {
  OPEN
  DONE
  CANCELED
}

// «Запросить помощь с подключением»: a club asks the platform's team to set it
// up by hand. A paid service (the setup fee, charged with the first paid
// period; the console may waive it with the «без платы за подключение» promo):
// the request only lands in the platform console — nothing starts by itself.
// Requester fields are denormalized so the row outlives the account.
model OnboardingHelpRequest {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  requestedById  String?  @db.Uuid
  requesterName  String   @db.VarChar(255)
  requesterEmail String?  @db.VarChar(255)
  phone          String?  @db.VarChar(32)
  message        String?  @db.Text

  status       OnboardingHelpStatus @default(OPEN)
  // The platform operator's note and who closed it.
  resolution   String?              @db.Text
  resolvedById String?              @db.Uuid
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([workspaceId, createdAt])
}

// «Показать демо» on the public landing: a club that is not a customer yet
// asks the platform's team for a demo. Not tied to a workspace or an account;
// read only in the platform console. consentAt records the visitor's consent
// to processing the contact details (the form refuses without it).
model DemoRequest {
  id String @id @default(uuid()) @db.Uuid

  name          String  @db.VarChar(120)
  clubName      String  @db.VarChar(160)
  city          String? @db.VarChar(120)
  // Phone or Telegram handle, as typed.
  contact       String  @db.VarChar(120)
  studentsCount Int?
  comment       String? @db.Text

  consentAt DateTime
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// How a club came to accept the platform's offer and data processing
// instruction (apps/client /legal/offer, /legal/dpa; docs/legal/README.md).
// SIGNUP: the owner created the club in the self-serve wizard. CONSOLE: the
// platform operator created the club and attests the owner accepted (signed
// offline). OWNER: the owner accepted an edition on the «Тариф» page or the
// banner. PAYMENT: the owner's first card payment.
enum ClubLegalAcceptanceSource {
  SIGNUP
  CONSOLE
  OWNER
  PAYMENT
}

// Every acceptance of the offer + DPA editions on behalf of a club, kept as
// evidence (who, which editions, when, from where). Append-only; the latest
// row is the club's standing (domains/billing/club-legal.ts). userId is a
// plain id with a name/e-mail snapshot: the evidence outlives the account
// and a change of owner.
model ClubLegalAcceptance {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The club owner who accepted.
  userId    String  @db.Uuid
  userEmail String? @db.VarChar(255)
  userName  String? @db.VarChar(255)

  offerVersion String                    @db.VarChar(64)
  dpaVersion   String                    @db.VarChar(64)
  source       ClubLegalAcceptanceSource
  acceptedAt   DateTime                  @default(now())
  ip           String?                   @db.VarChar(64)
  userAgent    String?                   @db.VarChar(512)

  // CONSOLE: the platform operator who recorded it.
  recordedById String? @db.Uuid
  // PAYMENT: the payment that carried the acceptance.
  paymentId    String? @db.Uuid

  @@index([workspaceId, acceptedAt])
}

// Who started the payment: the club's owner/admin on the «Тариф» page, the
// renewal job, or the platform operator («повторить сейчас»).
enum PlatformPaymentInitiator {
  OWNER
  AUTOPAY
  PLATFORM
}

// A payment from a club to ClubSpace, through the platform's own shop
// (PLATFORM_YOOKASSA_*). Created PENDING before the provider call (its
// idempotenceKey is the provider's Idempotence-Key), confirmed by the platform
// webhook or the synchronous answer of a saved-card charge, which extends the
// paid period (PERIOD) or turns the module on (MODULE). `lines` is the quote
// that was charged, frozen.
model PlatformPayment {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  kind      PlatformPaymentKind
  initiator PlatformPaymentInitiator
  // MODULE: the module being connected.
  module    PlatformModule?

  // PERIOD: months bought and the period they cover (set when applied — the
  // start is the later of the old period end and the moment of payment).
  // MODULE: the club's billing period and the part of it charged.
  periodMonths Int
  periodStart  DateTime?
  periodEnd    DateTime?

  // Whole rubles, like the quote. 0 = a free renewal (no provider call).
  amount         Int
  currency       String        @db.Char(3)
  // { lines, discounts, subtotal, discount, total, tierCode } as charged.
  lines          Json
  tierCode       String?       @db.VarChar(32)
  status         PaymentStatus @default(PENDING)
  // Partial refunds keep SUCCEEDED; REFUNDED once refundedAmount = amount.
  refundedAmount Int           @default(0)

  // null for a free renewal.
  provider          PaymentProvider?
  providerPaymentId String?          @unique @db.VarChar(255)
  confirmationUrl   String?          @db.Text
  // Unique per charge attempt; also the provider's Idempotence-Key, so a
  // retried run re-sends the same request instead of charging twice.
  idempotenceKey    String           @unique @db.VarChar(128)

  // Card the payment went through, for the history (saved or not).
  cardLast4     String? @db.VarChar(4)
  cardTitle     String? @db.VarChar(64)
  // Where the provider sent the 54-ФЗ receipt.
  receiptEmail  String? @db.VarChar(255)
  failureReason String? @db.VarChar(500)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paidAt     DateTime?
  refundedAt DateTime?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, kind])
}

// ═══════════════════════════════════════════════════════════════
// ONLINE PAYMENTS
// ═══════════════════════════════════════════════════════════════

// The club's own merchant account. Money goes straight to the club; the
// platform only creates payments with the club's credentials and listens to
// the provider's webhook.
enum PaymentProvider {
  YOOKASSA
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  REFUNDED
}

// One connected provider per club. Secrets are AES-GCM encrypted with
// ENCRYPTION_SECRET (shared/utils/encryption.util.ts) and never leave the
// server — clients get a «connected» flag and the last characters only.
model WorkspacePaymentSettings {
  workspaceId String    @id @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  // YooKassa shopId (not a secret — it is shown in the merchant dashboard URL).
  shopId   String? @db.VarChar(64)
  // YooKassa secret key or Stripe secret key, encrypted.
  secretKeyEncrypted String @db.Text
  // Last characters of the secret key, for the masked display.
  secretKeyHint      String @db.VarChar(8)
  // Stripe webhook signing secret (whsec_…), encrypted. YooKassa has none: its
  // notifications are verified by re-reading the payment from the API.
  webhookSecretEncrypted String? @db.Text

  // 54-ФЗ receipt sent with every YooKassa payment: the club's VAT code
  // (YooKassa vat_code 1–12), payment subject and mode.
  receiptEnabled Boolean @default(true)
  vatCode        Int     @default(1)
  paymentSubject String  @default("service") @db.VarChar(32)
  paymentMode    String  @default("full_prepayment") @db.VarChar(32)

  // Last successful «Проверить подключение»; cleared when credentials change.
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A member's online purchase of a tariff. Created PENDING before the provider
// call (its id is the provider-side metadata), confirmed by the webhook, which
// creates the Subscription and links it here.
model Payment {
  id String @id @default(uuid()) @db.Uuid

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // The buyer. Restrict: payments are financial records; account deletion
  // keeps (de-identifies) the User row, so this never blocks it.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // SetNull keeps the record if the tariff is deleted; planName is the
  // snapshot shown in lists.
  planId   String? @db.Uuid
  plan     Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName String  @db.VarChar(255)

  // The abonement this payment created (null until the webhook, or when it
  // could not be created — see activationError).
  subscriptionId String?       @unique @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  provider          PaymentProvider
  // YooKassa payment id / Stripe Checkout Session id; null only between the
  // row insert and the provider's answer.
  providerPaymentId String?         @unique @db.VarChar(255)
  // Where the member confirms the payment (provider's page).
  confirmationUrl   String?         @db.Text

  // Whole currency units, like Plan.price.
  amount   Int
  currency String        @db.Char(3)
  status   PaymentStatus @default(PENDING)

  // Sent as Idempotence-Key / Idempotency-Key with the create call.
  idempotenceKey String @unique @db.VarChar(64)

  // Paid, but the abonement could not be created automatically (e.g. a coach
  // sold one in the meantime). Staff decide by hand.
  activationError String? @db.VarChar(500)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paidAt     DateTime?
  refundedAt DateTime?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([userId, workspaceId, createdAt])
}

enum GuardianRelation {
  PARENT
  GUARDIAN
  OTHER
}

// A guardian's authority over a dependent — a User without a login (email
// null). The dependent is an ordinary club member (WorkspaceMember, groups,
// subscriptions, attendance, ranks) and the guardian acts for it with the
// `X-Act-As` header (AuthGuard). Created with consentAt set when the guardian
// adds the child themselves; a club adding a child creates the row with
// consentAt null — a pending invitation that only the guardian can confirm,
// recording the consent (152-ФЗ: a parent consents to a minor's data). Act-as
// and notification routing only ever use rows with consentAt set.
model Guardianship {
  id String @id @default(uuid()) @db.Uuid

  guardianId String @db.Uuid
  guardian   User   @relation("GuardianshipGuardian", fields: [guardianId], references: [id], onDelete: Cascade)

  dependentId String @db.Uuid
  dependent   User   @relation("GuardianshipDependent", fields: [dependentId], references: [id], onDelete: Cascade)

  relation GuardianRelation @default(PARENT)

  // Set when a club proposed the link (admin «Добавить ребёнка»).
  invitedByWorkspaceId String?    @db.Uuid
  invitedByWorkspace   Workspace? @relation(fields: [invitedByWorkspaceId], references: [id], onDelete: SetNull)
  invitedById          String?    @db.Uuid
  invitedBy            User?      @relation("GuardianshipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  // Guardian consent to processing the dependent's data. Null = pending.
  consentAt      DateTime?
  consentVersion String?   @db.VarChar(64)

  createdAt DateTime @default(now())

  @@unique([guardianId, dependentId])
  @@index([dependentId])
}

enum ClubImportStatus {
  UPLOADED
  PREVIEWING
  PREVIEWED
  APPLYING
  APPLIED
  FAILED
}

// One run of «Импорт клуба»: a CSV (saved from Excel) parsed on upload, then a
// dry-run preview and an apply, both processed in the background
// (features/club-import, queue `club-import`) with progress in processed/total.
// The parsed cells are kept here between the steps; the nightly purge deletes
// runs older than CLUB_IMPORT_RETENTION_DAYS (they hold personal data).
// rowResults: per-row outcome of the last preview/apply; missing: names the file
// references that the club doesn't have yet; summary: counts.
model ClubImport {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Audit-only: who uploaded. Not a relation, like WorkspaceInvitation.invitedById.
  createdById String? @db.Uuid

  fileName  String @db.VarChar(255)
  encoding  String @db.VarChar(32)
  delimiter String @db.VarChar(4)
  headers   Json
  rows      Json

  // Field key → column index, as confirmed in the wizard (null until preview).
  mapping       Json?
  createMissing Boolean @default(false)
  overwrite     Boolean @default(false)

  status     ClubImportStatus @default(UPLOADED)
  processed  Int              @default(0)
  total      Int              @default(0)
  summary    Json?
  missing    Json?
  rowResults Json?
  error      String?          @db.Text

  previewedAt DateTime?
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

// ИИ-ассистент: what an AI client may see of the club's people. PSEUDONYMIZED
// (default) — no names, phones or e-mails, members are stable pseudonyms;
// PERSONAL — only after the club owner accepted the personal-data transfer
// warning (AiDataTransferAcceptance).
enum AiTokenDataMode {
  PSEUDONYMIZED
  PERSONAL
}

// A personal access token an AI assistant (Claude, ChatGPT, Cursor, …) uses to
// read one club over MCP (POST /mcp, docs/mcp.md). Bound to one workspace and
// to its creator: every call re-resolves the creator's current role and
// directions, so a demoted or removed creator's token stops working. Only the
// SHA-256 of the secret is stored; the secret is shown once at creation.
// A new table, so the @unique on tokenHash is safe for `db push`.
model AiAccessToken {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String @db.Uuid
  createdBy   User   @relation("AiAccessTokenCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  name        String          @db.VarChar(100)
  // sha256(secret), hex.
  tokenHash   String          @unique @db.VarChar(64)
  // The first characters of the secret, so a list row can be matched with
  // the token pasted into a client («csai_AbC1…»).
  tokenPrefix String          @db.VarChar(16)
  // 'read' today; 'actions' is reserved (docs/mcp.md, «Действия»).
  scopes      String[]
  dataMode    AiTokenDataMode @default(PSEUDONYMIZED)

  // null = no expiry.
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  revokedById String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([createdById])
}

// Evidence that the club owner accepted the warning about transferring members'
// personal data to a third-party (possibly foreign) AI provider before
// creating a PERSONAL token. Append-only, like ClubLegalAcceptance: userId is a
// plain id with a name/e-mail snapshot so the evidence outlives the account.
model AiDataTransferAcceptance {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId    String  @db.Uuid
  userEmail String? @db.VarChar(255)
  userName  String? @db.VarChar(255)

  warningVersion String  @db.VarChar(64)
  // The token the acceptance was given for (plain id: survives revocation).
  tokenId        String? @db.Uuid

  acceptedAt DateTime @default(now())
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)

  @@index([workspaceId, acceptedAt])
}
