{
  "name": "@bjj-academy/server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
  "executor": "@nx/webpack:webpack",
  "dependsOn": ["prisma:generate"],
  "outputs": ["{options.outputPath}"],
  "options": {
    "target": "node",
    "compiler": "tsc",
    "main": "{projectRoot}/src/app/main.ts",
    "tsConfig": "{projectRoot}/tsconfig.app.json",
    "outputPath": "{workspaceRoot}/dist/apps/server",
    "optimization": false,
    "outputHashing": "none",
    "sourceMaps": true,
    "webpackConfig": "{projectRoot}/webpack.config.js",
    "generatePackageJson": true
  }}
,
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/server/dist/package.json",
          "{workspaceRoot}/apps/server/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/server/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
  "continuous": true,
  "executor": "@nx/js:node",
  "defaultConfiguration": "development",
  "dependsOn": ["build", "prisma:prepare"],
  "options": {
    "buildTarget": "@bjj-academy/server:build",
    "runBuildTargetDependencies": true,
    "watch": false
  },
  "configurations": {
    "development": { "buildTarget": "@bjj-academy/server:build:development" },
    "production": { "buildTarget": "@bjj-academy/server:build:production" }
  }
},
"prisma:prepare": {
  "executor": "nx:run-commands",
  "options": {
    "cwd": "{workspaceRoot}",
    "command": "prisma db push --accept-data-loss --config apps/server/prisma.config.ts && prisma generate --config apps/server/prisma.config.ts"
  }
},
      "prisma:generate": {
  "executor": "nx:run-commands",
  "cache": true,
  "inputs": [
    "{projectRoot}/prisma/schema.prisma",
    "{projectRoot}/prisma.config.ts",
    "{workspaceRoot}/.env"
  ],
  "outputs": ["{projectRoot}/src/infrastructure/prisma/generated"],
  "options": {
    "command": "prisma generate --config apps/server/prisma.config.ts",
    "cwd": "{workspaceRoot}"
  }
},
"prisma:migrate:deploy": {
  "executor": "nx:run-commands",
  "options": {
    "command": "prisma migrate deploy --config apps/server/prisma.config.ts",
    "cwd": "{workspaceRoot}"
  }
},
"open-api:prepare": {
  "executor": "@nx/webpack:webpack",
  "dependsOn": ["build"],
  "outputs": ["{options.outputPath}"],
  "options": {
    "target": "node",
    "compiler": "tsc",
    "main": "{projectRoot}/src/generate-open-api.tool.ts",
    "tsConfig": "{projectRoot}/tsconfig.app.json",
    "outputPath": "{workspaceRoot}/dist/apps/server-openapi",
    "optimization": false,
    "outputHashing": "none",
    "sourceMaps": true,
    "webpackConfig": "{projectRoot}/webpack.config.js"
  }
},

"open-api:generate": {
  "executor": "@nx/js:node",
  "cache": true,
  "inputs": ["{projectRoot}/src/**/*", "{workspaceRoot}/.env"],
  "outputs": ["{workspaceRoot}/open-api.json"],
  "options": {
    "watch": false,
    "inspect": false,
    "buildTarget": "@bjj-academy/server:open-api:prepare"
  }
}






    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
