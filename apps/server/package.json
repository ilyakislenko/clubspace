{
  "name": "@clubspace/server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "prisma:generate"
        ]
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/server/dist/package.json",
          "{workspaceRoot}/apps/server/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/server/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "dependsOn": [
          "build",
          "prisma:prepare"
        ],
        "options": {
          "buildTarget": "@clubspace/server:build",
          "runBuildTargetDependencies": true,
          "watch": false
        }
      },
      "prisma:prepare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "prisma db push --accept-data-loss --config apps/server/prisma.config.ts && prisma generate --config apps/server/prisma.config.ts"
        }
      },
      "prisma:generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma.config.ts",
          "{workspaceRoot}/.env"
        ],
        "outputs": [
          "{projectRoot}/src/infrastructure/prisma/generated"
        ],
        "options": {
          "command": "prisma generate --config apps/server/prisma.config.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "prisma:migrate:deploy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate deploy --config apps/server/prisma.config.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "open-api:prepare": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{workspaceRoot}/dist/apps/server-openapi"
        ],
        "options": {
          "command": "webpack-cli build --env bundle=openapi",
          "cwd": "{projectRoot}"
        }
      },
      "open-api:generate": {
        "executor": "@nx/js:node",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*",
          "{workspaceRoot}/.env"
        ],
        "outputs": [
          "{workspaceRoot}/open-api.json"
        ],
        "options": {
          "watch": false,
          "inspect": false,
          "buildTarget": "@clubspace/server:open-api:prepare"
        }
      },
      "demo:prepare": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prisma:generate"
        ],
        "outputs": [
          "{workspaceRoot}/dist/apps/server-demo"
        ],
        "options": {
          "command": "webpack-cli build --env bundle=demo",
          "cwd": "{projectRoot}"
        }
      },
      "demo:reset": {
        "executor": "@nx/js:node",
        "options": {
          "watch": false,
          "inspect": false,
          "buildTarget": "@clubspace/server:demo:prepare"
        }
      }
    },
    "// targets": "to see all targets run: nx show project @clubspace/server --web"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
