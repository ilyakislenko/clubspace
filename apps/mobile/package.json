{
  "name": "@clubspace/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-pre-install": "node scripts/check-release-env.mjs",
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/mobile",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:pwa": "node scripts/build-pwa.mjs",
    "serve:pwa": "node scripts/serve-pwa.mjs",
    "start:web": "node scripts/sync-web-assets.mjs && expo start --web"
  },
  "dependencies": {
    "@expo/metro-config": "*",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "*",
    "@react-navigation/bottom-tabs": "*",
    "@react-navigation/native": "*",
    "@react-navigation/elements": "*",
    "@react-navigation/native-stack": "*",
    "@testing-library/react-native": "*",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "expo-video": "~58.0.13",
    "jest-expo": "*",
    "metro-config": "*",
    "metro-resolver": "*",
    "react": "*",
    "react-dom": "19.3.0",
    "react-native": "*",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-web": "*",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "sharp": "^0.35.5"
  },
  "expo": {
    "install": {
      "exclude": ["typescript"]
    }
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "@nx/jest:jest",
        "options": {
          "jestConfig": "apps/mobile/jest.config.cjs",
          "passWithNoTests": true
        }
      }
    }
  }
}
