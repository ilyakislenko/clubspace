{
  "name": "@clubspace/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "eas-build-pre-install": "node scripts/check-release-env.mjs",
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/mobile",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:pwa": "node scripts/build-pwa.mjs",
    "serve:pwa": "node scripts/serve-pwa.mjs",
    "start:web": "node scripts/sync-web-assets.mjs && expo start --web",
    "update:ota": "node scripts/eas-update.mjs"
  },
  "dependencies": {
    "@expo/metro-config": "*",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "*",
    "@react-navigation/bottom-tabs": "*",
    "@react-navigation/elements": "*",
    "@react-navigation/native": "*",
    "@react-navigation/native-stack": "*",
    "@testing-library/react-native": "*",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "expo-updates": "~58.0.22",
    "expo-video": "~58.0.14",
    "jest-expo": "^58.0.15",
    "metro-config": "*",
    "metro-resolver": "*",
    "react": "*",
    "react-dom": "19.3.1",
    "react-native": "*",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "*",
    "react-native-svg-transformer": "*",
    "react-native-web": "*",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "babel-plugin-transform-remove-console": "^6.9.4",
    "sharp": "^0.35.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "nx": {
    "// targets": "to see all targets run: nx show project @clubspace/mobile --web"
  }
}
