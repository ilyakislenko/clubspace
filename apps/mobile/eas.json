{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_BRAND": "grappling"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.clubspace.example.com",
        "EXPO_PUBLIC_BRAND": "grappling"
      }
    },
    "production": {
      "_comment": "env.EXPO_PUBLIC_API_URL and env.EXPO_PUBLIC_BRAND override the values baked into app.json `extra` at build time — production binaries always hit the prod API regardless of what the local app.json says.",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.clubspace.example.com",
        "EXPO_PUBLIC_BRAND": "grappling"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APPLE_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
