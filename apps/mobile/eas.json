{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_BRAND": "grappling"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.clubspace.example.com",
        "EXPO_PUBLIC_BRAND": "grappling",
        "EXPO_PUBLIC_WORKSPACE_KEY": "REPLACE_WITH_YOUR_CLUB_KEY"
      }
    },
    "production": {
      "_comment": "production = APK for hand distribution (files handed to students). store = AAB for Google Play, which cannot accept an APK; it extends production so it inherits the same env. env values override what app.json bakes into `extra`, so a binary always hits the deploy's API regardless of the local app.json. Run scripts/set-mobile-target.sh to fill in the API URL, web URL, club key and support email.",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.clubspace.example.com",
        "EXPO_PUBLIC_BRAND": "grappling",
        "EXPO_PUBLIC_WORKSPACE_KEY": "REPLACE_WITH_YOUR_CLUB_KEY",
        "EXPO_PUBLIC_WEB_URL": "REPLACE_WITH_WEB_URL",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "REPLACE_WITH_SUPPORT_EMAIL"
      }
    },
    "store": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APPLE_APP_ID"
      }
    },
    "store": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
