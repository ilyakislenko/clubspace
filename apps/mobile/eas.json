{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_BRAND": "grappling"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.clubspace.example.com",
        "EXPO_PUBLIC_BRAND": "grappling",
        "EXPO_PUBLIC_WORKSPACE_KEY": "REPLACE_WITH_YOUR_CLUB_KEY"
      }
    },
    "production": {
      "_comment": "env values override what app.json bakes into `extra`, so a production binary always hits the deploy's API regardless of the local app.json. buildType is apk, not app-bundle: these builds are handed to students as files. Switch to app-bundle only when submitting to Google Play, which cannot accept an APK. Run scripts/set-mobile-target.sh to fill in the API URL and club key.",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.clubspace.example.com",
        "EXPO_PUBLIC_BRAND": "grappling",
        "EXPO_PUBLIC_WORKSPACE_KEY": "REPLACE_WITH_YOUR_CLUB_KEY"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APPLE_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
