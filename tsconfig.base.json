{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@clubspace/source"],
    "baseUrl": ".",
    "paths": {
      "@clubspace/api-client": ["libs/api-client/src/index.ts"],
      "@clubspace/ui-kit/util": ["libs/ui-kit/util/index.ts"],
      "@clubspace/ui-kit/ui": ["libs/ui-kit/ui/index.ts"],
      "@clubspace/ui-kit/brand": ["libs/ui-kit/brand/index.ts"],
      "@clubspace/prisma-client": ["libs/prisma-client/src/index.ts"]
    }
  }
}
