{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@bjj-academy/source"],
    "paths": {
      "@bjj-academy/ui-kit/util": ["libs/ui-kit/util/index.ts"],
      "@bjj-academy/ui-kit/ui": ["libs/ui-kit/ui/index.ts"]
    }
  }
}
