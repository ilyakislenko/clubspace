  "//nestjs-zod": "Pinned to exactly 5.5.0 because patches/nestjs-zod+5.5.0.patch (applied by `postinstall`) backports the unreleased upstream fix nestjs-zod#477: zod >= 4.5 emits `type: [\"string\", \"null\"]` for nullable primitives, which @nestjs/swagger 11 turns into `type: array` in open-api.json (nestjs-zod#473/#474). Drop the patch, the pin and patch-package with the nestjs-zod release that ships #477; regenerate the contract and expect no diff.",
  "//overrides": {
    "nunjucks.chokidar": "nunjucks is an optional peer of @nestjs-modules/mailer we never install; npm still resolves its optional chokidar@^3 peer and refuses the tree (chokidar 4 is hoisted). Drop when nunjucks accepts chokidar 4.",
    "@nestjs/platform-express.multer": "platform-express 11.2.8 (latest 11.x) pins multer 2.4.0 (DoS advisories, fixed in 2.5.0). Drop when an 11.x release or Nest 12 ships multer >= 2.5.",
    "serialize-javascript": "build-only (webpack plugins under @nx/webpack/@nx/next): copy-webpack-plugin 10 and css-minimizer 5 accept ^6 only; 7.x keeps the same API and fixes the RCE/XSS advisories. Drop with an Nx release that moves past them."
  },
  "overrides": {
    "nunjucks": {
      "chokidar": "^4.0.3"
    },
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    },
    "serialize-javascript": "^7.1.4"
  },
