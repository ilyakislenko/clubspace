  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:infra": "docker compose up -d postgres redis minio minio-init maildev",
    "dev:down": "docker compose stop postgres redis minio minio-init maildev",
    "theme:generate": "tsx libs/ui-kit/util/generate-theme-css.ts",
    "test:server": "nx test @clubspace/server",
    "test:mobile": "nx test @clubspace/mobile",
    "test:e2e": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=4096\" nx e2e @clubspace/server-e2e",
    "test:all": "nx run-many -t test --projects=@clubspace/server,@clubspace/admin,@clubspace/mobile,@clubspace/video-worker",
    "test:watch:server": "nx test @clubspace/server --watch",
    "test:watch:mobile": "nx test @clubspace/mobile --watch",
    "test:coverage": "nx run-many -t test --projects=@clubspace/server,@clubspace/admin,@clubspace/mobile,@clubspace/video-worker --coverage",
    "verify": "bash scripts/verify.sh",
    "demo:reset": "nx run @clubspace/server:demo:reset --skip-sync",
    "hooks:install": "git config core.hooksPath .githooks && echo \"pre-push hook installed (core.hooksPath=.githooks)\"",
    "test:admin": "nx test @clubspace/admin",
    "postinstall": "patch-package"
  },
