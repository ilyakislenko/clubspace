# Static server inside the `pwa` image (apps/mobile/Dockerfile). Plain HTTP on
# the internal network only; the stack's Caddy (deploy/Caddyfile) terminates
# TLS for pwa.<domain> and proxies here.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed bundles never change under the same name. Everything else — the
	# shell, the service worker, the manifest — is revalidated on every load,
	# so a new deploy reaches members on their next visit.
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /_expo/static/*
	header @other Cache-Control "no-cache"

	# Content-Security-Policy. The shell has no inline script (public/
	# boot-splash.js, register-sw.js), so scripts are this origin only; styles
	# keep 'unsafe-inline' for react-native-web's injected sheets and the
	# shell's own <style>. HLS playlists come from the API, segments, images and
	# offline downloads from object storage, live updates over the API's socket.
	# Those origins come from the container's environment (docker-compose.prod.yml,
	# service `pwa`) rather than being baked in: origins only, no path. An unset
	# one is simply left out.
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$PWA_MEDIA_ORIGIN} {$PWA_ACCELERATE_ORIGIN}; media-src 'self' blob: {$PWA_API_ORIGIN} {$PWA_MEDIA_ORIGIN} {$PWA_ACCELERATE_ORIGIN}; font-src 'self' data:; connect-src 'self' {$PWA_API_ORIGIN} {$PWA_SOCKET_ORIGIN} {$PWA_MEDIA_ORIGIN} {$PWA_ACCELERATE_ORIGIN}; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# Client-side routes (/join/<code>, /courses/…) are all the app shell.
	try_files {path} /index.html
	file_server
}
