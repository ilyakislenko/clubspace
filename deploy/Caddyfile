# Caddy v2 reverse proxy for ClubSpace.
#
# Automatic HTTPS via Let's Encrypt. Every hostname below is built from the
# DOMAIN environment variable, which docker-compose.prod.yml passes in from
# .env.production — one place to change, five sites.
#
# All five A-records must point at this host *before* the container starts,
# otherwise the ACME HTTP-01 challenge fails and Caddy burns Let's Encrypt
# rate limit retrying.
#
# The file is bind-mounted, and a running Caddy keeps the version it started
# with. deploy/update.sh restarts caddy when an update changes this file; after
# an edit by hand: docker compose -f docker-compose.prod.yml --env-file
# .env.production restart caddy
{
	# Global options
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
	# CADDY_GLOBAL_OPTIONS in .env.production, empty by default (real Let's
	# Encrypt certificates). A dry run on a fresh box without wasting the
	# production rate limit:
	#   acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	# A rehearsal on a test domain with no public DNS: Caddy's own CA —
	#   local_certs
	{$CADDY_GLOBAL_OPTIONS}
}

api.{$DOMAIN} {
	encode zstd gzip

	# Security headers
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Remove server fingerprint
		-Server
	}

	# Reverse proxy to the NestJS server. The transport block keeps
	# WebSocket / SSE connections open and bumps timeouts so video upload
	# requests don't get cut off mid-flight.
	reverse_proxy server:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		transport http {
			read_timeout 10m
			write_timeout 10m
			dial_timeout 10s
		}
	}

	# Lightweight access log
	log {
		output stdout
		format console
		level INFO
	}
}

# Admin panel (Next.js).
admin.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy admin:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format console
		level INFO
	}
}

# Student web app (Next.js).
app.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy client:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format console
		level INFO
	}
}

# Installable web app (the Expo PWA): static files from the `pwa` container.
pwa.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy pwa:8080
	log {
		output stdout
		format console
		level INFO
	}
}

# Object storage (MinIO). Uploads and HLS segments travel directly between the
# client and this host via presigned URLs — the API never proxies those bytes,
# which is why storage needs its own public name.
#
# Only what browsers and phones send gets through: GET/HEAD of an object
# (segments, thumbnails, subtitles, offline downloads), PUT of an object (the
# presigned upload — a single PUT, not multipart) and OPTIONS (its CORS
# preflight), all under /<bucket>/<key>. Everything else — MinIO's admin,
# metrics and health APIs under /minio/, bucket listings and policies,
# multipart and batch-delete POSTs, DELETE — is refused here. The server and
# the worker need some of those, and they reach MinIO directly on the internal
# network (S3_INTERNAL_URL), never through this site.
#
# No `encode`: video segments are already compressed, so gzip would burn CPU
# for nothing. Timeouts are upload-sized — a coach pushing a 2 GB training
# recording over a slow line must not be cut off mid-flight.
s3.{$DOMAIN} {
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	@object {
		method GET HEAD PUT OPTIONS
		path_regexp ^/{$S3_BUCKET_NAME:clubspace}/.+
	}

	handle @object {
		reverse_proxy minio:9000 {
			# MinIO verifies the presigned signature against the Host header, so
			# it must arrive unchanged.
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}

			transport http {
				read_timeout 30m
				write_timeout 30m
				dial_timeout 10s
			}
		}
	}

	handle {
		respond 403
	}

	log {
		output stdout
		format console
		level INFO
	}
}
