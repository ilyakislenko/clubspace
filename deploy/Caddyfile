# Caddy v2 reverse proxy for the ClubSpace API.
#
# Automatic HTTPS via Let's Encrypt. Every hostname below is built from the
# DOMAIN environment variable, which docker-compose.prod.yml passes in from
# .env.production — one place to change, four sites.
#
# All four A-records must point at this host *before* the container starts,
# otherwise the ACME HTTP-01 challenge fails and Caddy burns Let's Encrypt
# rate limit retrying.
{
	# Global options
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

api.{$DOMAIN} {
	encode zstd gzip

	# Security headers
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Remove server fingerprint
		-Server
	}

	# Reverse proxy to the NestJS server. The transport block keeps
	# WebSocket / SSE connections open and bumps timeouts so video upload
	# requests don't get cut off mid-flight.
	reverse_proxy server:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		transport http {
			read_timeout 10m
			write_timeout 10m
			dial_timeout 10s
		}
	}

	# Lightweight access log
	log {
		output stdout
		format console
		level INFO
	}
}

# Admin panel (Next.js).
admin.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy admin:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format console
		level INFO
	}
}

# Student web app (Next.js).
app.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy client:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format console
		level INFO
	}
}

# Object storage (MinIO). Uploads and HLS segments travel directly between the
# client and this host via presigned URLs — the API never proxies those bytes,
# which is why storage needs its own public name.
#
# No `encode`: video segments are already compressed, so gzip would burn CPU
# for nothing. Timeouts are upload-sized — a coach pushing a 2 GB training
# recording over a slow line must not be cut off mid-flight.
s3.{$DOMAIN} {
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy minio:9000 {
		# MinIO verifies the presigned signature against the Host header, so it
		# must arrive unchanged.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		transport http {
			read_timeout 30m
			write_timeout 30m
			dial_timeout 10s
		}
	}

	log {
		output stdout
		format console
		level INFO
	}
}
