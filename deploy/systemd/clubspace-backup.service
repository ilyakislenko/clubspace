# Installed by deploy/bootstrap.sh (@INSTALL_DIR@ is substituted).
[Unit]
Description=ClubSpace: encrypted database backup to S3
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=@INSTALL_DIR@/deploy/backup-s3.sh
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
